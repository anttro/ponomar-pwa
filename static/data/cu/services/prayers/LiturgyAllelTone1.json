[{"type": "TEXT", "value": "А҆ллилꙋ́їа, гла́съ а҃:", "who": "R"}, {"type": "TEXT", "value": "А҆ллилꙋ́їа, а҆ллилꙋ́їа, а҆ллилꙋ́їа.", "who": "C"}, {"type": "TEXT", "value": "Бг҃ъ даѧ́й ѿмще́нїе мнѣ̀, и҆ покори́вый лю́ди под̾ мѧ̀.", "who": "R"}, {"type": "TEXT", "value": "А҆ллилꙋ́їа, а҆ллилꙋ́їа, а҆ллилꙋ́їа.", "who": "C"}, {"type": "TEXT", "value": "Велича́ѧй спасє́нїѧ цр҃е́ва, и҆ творѧ́й млⷭ҇ть хрⷭ҇тꙋ̀ своемꙋ̀ дв҃дꙋ, и҆ сѣ́мени є҆гѡ̀ до вѣ́ка.", "who": "R"}, {"type": "TEXT", "value": "А҆ллилꙋ́їа, а҆ллилꙋ́їа, а҆ллилꙋ́їа.", "who": "C"}]