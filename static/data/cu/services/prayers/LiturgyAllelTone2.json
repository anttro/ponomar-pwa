[{"type": "TEXT", "value": "А҆ллилꙋ́їа, гла́съ в҃:", "who": "R"}, {"type": "TEXT", "value": "А҆ллилꙋ́їа, а҆ллилꙋ́їа, а҆ллилꙋ́їа.", "who": "C"}, {"type": "TEXT", "value": "Оу҆слы́шитъ тѧ̀ гдⷭ҇ь въ де́нь печа́ли, защи́титъ тѧ̀ и҆́мѧ бг҃а і҆а́кѡвлѧ.", "who": "R"}, {"type": "TEXT", "value": "А҆ллилꙋ́їа, а҆ллилꙋ́їа, а҆ллилꙋ́їа.", "who": "C"}, {"type": "TEXT", "value": "Гдⷭ҇и, спасѝ цр҃ѧ̀, и҆ ᲂу҆слы́ши ны̀, во́ньже а҆́ще де́нь призове́мъ тѧ̀.", "who": "R"}, {"type": "TEXT", "value": "А҆ллилꙋ́їа, а҆ллилꙋ́їа, а҆ллилꙋ́їа.", "who": "C"}]