[{"type": "HEADER", "value": "\u0404\u0486\u043a\u0442\u0435\u043d\u0457\u0430\u0300 \u043c\u0430\u0301\u043b\u0430\u0467."}, {"type": "TEXT", "value": "\u041f\u0430\u0301\u043a\u0438 \u0438\u0486 \u043f\u0430\u0301\u043a\u0438 \u043c\u0438\u0301\u0440\u043e\u043c\u044a \u0433\u0434\u2ded\u0487\ua64b \u043f\u043e\u043c\u043e\u0301\u043b\u0438\u043c\u0441\u0467.", "who": "D"}, {"type": "TEXT", "value": "\u0413\u0434\u2ded\u0487\u0438, \u043f\u043e\u043c\u0438\u0301\u043b\ua64b\u0439.", "who": "C"}, {"type": "TEXT", "value": "\u0417\u0430\u0441\u0442\ua64b\u043f\u045d, \u0441\u043f\u0430\u0441\u045d, \u043f\u043e\u043c\u0438\u0301\u043b\ua64b\u0439 \u0438\u0486 \u0441\u043e\u0445\u0440\u0430\u043d\u045d \u043d\u0430\u0301\u0441\u044a, \u0431\u0436\u0483\u0435, \u0442\u0432\u043e\u0435\u0301\u044e \u0431\u043b\u0483\u0433\u043e\u0434\u0430\u0301\u0442\u0457\u044e.", "who": "D"}, {"type": "TEXT", "value": "\u0413\u0434\u2ded\u0487\u0438, \u043f\u043e\u043c\u0438\u0301\u043b\ua64b\u0439.", "who": "C"}, {"type": "TEXT", "value": "\u041f\u0440\u0435\u0441\u0442\u0483\ua64b\u0301\u044e, \u043f\u0440\u0435\u0447\u2ded\u0487\u0442\ua64b\u044e, \u043f\u0440\u0435\u0431\u043b\u0483\u0433\u043e\u0441\u043b\u043e\u0432\u0435\u0301\u043d\u043d\ua64b\u044e, \u0441\u043b\u0430\u0301\u0432\u043d\ua64b\u044e \u0432\u043b\u2de3\u0447\u0446\ua64b \u043d\u0430\u0301\u0448\ua64b \u0431\u0446\u2de3\ua64b \u0438\u0486 \u043f\u0440\u0438\u0441\u043d\u043e\u0434\u0432\u0483\ua64b \u043c\u0440\u0483\u0456\u0301\u044e, \u0441\u043e \u0432\u0441\u0463\u0301\u043c\u0438 \u0441\u0442\u0483\u044b\u0301\u043c\u0438 \u043f\u043e\u043c\u0467\u043d\ua64b\u0301\u0432\u0448\u0435, \u0441\u0430\u0301\u043c\u0438 \u0441\u0435\u0431\u0450, \u0438\u0486 \u0434\u0440\ua64b\u0301\u0433\u044a \u0434\u0440\ua64b\u0301\u0433\u0430, \u0438\u0486 \u0432\u0435\u0301\u0441\u044c \u0436\u0438\u0432\u043e\u0301\u0442\u044a \u043d\u0430\u0301\u0448\u044a \u0445\u0440\u2ded\u0487\u0442\ua64b\u0300 \u0431\u0433\u0483\ua64b \u043f\u0440\u0435\u0434\u0430\u0434\u0438\u0301\u043c\u044a.", "who": "D"}, {"type": "TEXT", "value": "\u0422\u0435\u0431\u0463\u0300, \u0433\u0434\u2ded\u0487\u0438.", "who": "C"}]