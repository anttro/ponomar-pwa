[{"type": "TEXT", "value": "А҆ллилꙋ́їа, гла́съ г҃:", "who": "R"}, {"type": "TEXT", "value": "А҆ллилꙋ́їа, а҆ллилꙋ́їа, а҆ллилꙋ́їа.", "who": "C"}, {"type": "TEXT", "value": "На тѧ̀ гдⷭ҇и ᲂу҆пова́хъ, да не постыжꙋ́сѧ во вѣ́къ.", "who": "R"}, {"type": "TEXT", "value": "А҆ллилꙋ́їа, а҆ллилꙋ́їа, а҆ллилꙋ́їа.", "who": "C"}, {"type": "TEXT", "value": "Бꙋ́ди мѝ въ бг҃а защи́тителѧ, и҆ въ до́мъ прибѣ́жища, є҆́же спасти́ мѧ.", "who": "R"}, {"type": "TEXT", "value": "А҆ллилꙋ́їа, а҆ллилꙋ́їа, а҆ллилꙋ́їа.", "who": "C"}]