[{"type": "TEXT", "value": "Помоли́тесѧ, ѡ҆глаше́ннїи, гдⷭ҇ви.", "who": "D"}, {"type": "TEXT", "value": "Гдⷭ҇и поми́лꙋй.", "who": "C"}, {"type": "TEXT", "value": "Вѣ́рнїи, ѡ҆ ѡ҆глаше́нныхъ помо́лимсѧ, да гдⷭ҇ь поми́лꙋетъ ѧ҆̀.", "who": "D"}, {"type": "TEXT", "value": "Гдⷭ҇и поми́лꙋй.", "who": "C"}, {"type": "TEXT", "value": "Ѡ҆гласи́тъ и҆̀хъ сло́вомъ и҆́стины.", "who": "D"}, {"type": "TEXT", "value": "Гдⷭ҇и поми́лꙋй.", "who": "C"}, {"type": "TEXT", "value": "Ѿкры́етъ и҆̀мъ є҆ѵⷢ҇лїе пра́вды.", "who": "D"}, {"type": "TEXT", "value": "Гдⷭ҇и поми́лꙋй.", "who": "C"}, {"type": "TEXT", "value": "Соедини́тъ и҆̀хъ ст҃ѣ́й свое́й собо́рнѣй и҆ а҆пⷭ҇льстѣй це́ркви.", "who": "D"}, {"type": "TEXT", "value": "Гдⷭ҇и поми́лꙋй.", "who": "C"}, {"type": "TEXT", "value": "Спасѝ, поми́лꙋй, застꙋпѝ и҆ сохранѝ и҆̀хъ, бж҃е, твое́ю бл҃года́тїю.", "who": "D"}, {"type": "TEXT", "value": "Гдⷭ҇и поми́лꙋй.", "who": "C"}, {"type": "TEXT", "value": "Ѡ҆глаше́ннїи, главы̑ ва́шѧ гдⷭ҇ви приклони́те.", "who": "D"}, {"type": "TEXT", "value": "Тебѣ̀, гдⷭ҇и.", "who": "C"}, {"type": "TEXT", "value": "Да и҆ ті́и съ на́ми сла́вѧтъ пречестно́е и҆ вели́кое и҆́мѧ твоѐ, ѻ҆ц҃а̀, и҆ сн҃а, и҆ ст҃а́гѡ дх҃а, ны́нѣ и҆ при́снѡ, и҆ во вѣ́ки вѣкѡ́въ.", "who": "P"}, {"type": "TEXT", "value": "А҆ми́нь.", "who": "C"}, {"type": "TEXT", "value": "Є҆ли́цы ѡ҆глаше́ннїи, и҆зыди́те. Ѿглаше́ннїи, и҆зыди́те.", "who": "D"}]