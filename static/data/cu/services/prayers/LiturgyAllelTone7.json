[{"type": "TEXT", "value": "А҆ллилꙋ́їа, гла́съ з҃:", "who": "R"}, {"type": "TEXT", "value": "А҆ллилꙋ́їа, а҆ллилꙋ́їа, а҆ллилꙋ́їа.", "who": "C"}, {"type": "TEXT", "value": "Бл҃го є҆́сть и҆сповѣ́датисѧ гдⷭ҇ви, и҆ пѣ́ти и҆́мени твоемꙋ̀ вы́шнїй.", "who": "R"}, {"type": "TEXT", "value": "А҆ллилꙋ́їа, а҆ллилꙋ́їа, а҆ллилꙋ́їа.", "who": "C"}, {"type": "TEXT", "value": "Возвѣща́ти заꙋ́тра ми́лость твою̀, и҆ и҆́стинꙋ твою̀ на всѧ́кꙋ но́щь.", "who": "R"}, {"type": "TEXT", "value": "А҆ллилꙋ́їа, а҆ллилꙋ́їа, а҆ллилꙋ́їа.", "who": "C"}]