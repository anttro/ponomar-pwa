[{"type": "TEXT", "value": "А҆ллилꙋ́їа, гла́съ и҃:", "who": "R"}, {"type": "TEXT", "value": "А҆ллилꙋ́їа, а҆ллилꙋ́їа, а҆ллилꙋ́їа.", "who": "C"}, {"type": "TEXT", "value": "Прїиди́те возра́дꙋемсѧ гдⷭ҇ви, воскли́кнемъ бг҃ꙋ сп҃си́телю на́шемꙋ.", "who": "R"}, {"type": "TEXT", "value": "А҆ллилꙋ́їа, а҆ллилꙋ́їа, а҆ллилꙋ́їа.", "who": "C"}, {"type": "TEXT", "value": "Предвари́мъ лицѐ є҆гѡ̀ во и҆сповѣ́данїи, и҆ во ѱалмѣ́хъ воскли́кнемъ є҆мꙋ̀.", "who": "R"}, {"type": "TEXT", "value": "А҆ллилꙋ́їа, а҆ллилꙋ́їа, а҆ллилꙋ́їа.", "who": "C"}]