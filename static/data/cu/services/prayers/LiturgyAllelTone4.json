[{"type": "TEXT", "value": "А҆ллилꙋ́їа, гла́съ д҃:", "who": "R"}, {"type": "TEXT", "value": "А҆ллилꙋ́їа, а҆ллилꙋ́їа, а҆ллилꙋ́їа.", "who": "C"}, {"type": "TEXT", "value": "Налѧцы̀, и҆ ᲂу҆спѣва́й, и҆ ца́рствꙋй, и҆́стины ра́ди и҆ кро́тости и҆ пра́вды.", "who": "R"}, {"type": "TEXT", "value": "А҆ллилꙋ́їа, а҆ллилꙋ́їа, а҆ллилꙋ́їа.", "who": "C"}, {"type": "TEXT", "value": "Возлюби́лъ є҆сѝ пра́вдꙋ, и҆ возненави́дѣлъ є҆сѝ беззако́нїе.", "who": "R"}, {"type": "TEXT", "value": "А҆ллилꙋ́їа, а҆ллилꙋ́їа, а҆ллилꙋ́їа.", "who": "C"}]