[{"type": "LITANY"}, {"type": "HEADER", "value": "Litany of the Catechumens."}, {"type": "TEXT", "value": "Pray, catechumens, to the Lord.", "who": "D"}, {"type": "TEXT", "value": "Lord, have mercy.", "who": "C"}, {"type": "TEXT", "value": "Faithful, let us pray for the catechumens.", "who": "D"}, {"type": "TEXT", "value": "Lord, have mercy.", "who": "C"}, {"type": "TEXT", "value": "That the Lord may have mercy on them, instruct them in the word of truth, and reveal to them the Gospel of righteousness.", "who": "D"}, {"type": "TEXT", "value": "Lord, have mercy.", "who": "C"}]