{"53": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u1f08\u03b3\u03b1\u03c0\u03b7\u03c4\u1f78\u03c2 \u1f41 \u1f08\u03bd\u03ac\u03c1\u03b3\u03c5\u03c1\u03bf\u03c2 \u03ba\u03b1\u1f76 \u1f38\u03b1\u03bc\u03b1\u03c4\u03b9\u03ba\u03cc\u03c2", "short": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u1f08\u03b3\u03b1\u03c0\u03b7\u03c4\u1f78\u03c2 \u1f41 \u1f08\u03bd\u03ac\u03c1\u03b3\u03c5\u03c1\u03bf\u03c2 \u03ba\u03b1\u1f76 \u1f38\u03b1\u03bc\u03b1\u03c4\u03b9\u03ba\u03cc\u03c2"}}, "501": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0393\u03b5\u03c1\u03ac\u03c3\u03b9\u03bc\u03bf\u03c2 \u1f21\u03b3\u03bf\u03cd\u03bc\u03b5\u03bd\u03bf\u03c2 \u1f39\u03b5\u03c1\u1fb6\u03c2 \u03bc\u03bf\u03bd\u1fc6\u03c2 \u1f09\u03b3\u03af\u03b1\u03c2 \u03a4\u03c1\u03b9\u03ac\u03b4\u03bf\u03c2 \u1f10\u03bd \u039c\u03c0\u03bf\u03bb\u03c4\u1f76\u03bd\u03c3\u03ba", "short": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0393\u03b5\u03c1\u03ac\u03c3\u03b9\u03bc\u03bf\u03c2 \u1f21\u03b3\u03bf\u03cd\u03bc\u03b5\u03bd\u03bf\u03c2 \u1f39\u03b5\u03c1\u1fb6\u03c2 \u03bc\u03bf\u03bd\u1fc6\u03c2 \u1f09\u03b3\u03af\u03b1\u03c2 \u03a4\u03c1\u03b9\u03ac\u03b4\u03bf\u03c2 \u1f10\u03bd \u039c\u03c0\u03bf\u03bb\u03c4\u1f76\u03bd\u03c3\u03ba"}}, "503": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0393\u03b5\u03c1\u03ac\u03c3\u03b9\u03bc\u03bf\u03c2 \u03c4\u1fc6\u03c2 \u0392\u03bf\u03bb\u03bf\u03b3\u03ba\u03bd\u03c4\u1f70", "short": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0393\u03b5\u03c1\u03ac\u03c3\u03b9\u03bc\u03bf\u03c2 \u03c4\u1fc6\u03c2 \u0392\u03bf\u03bb\u03bf\u03b3\u03ba\u03bd\u03c4\u1f70"}}, "504": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0393\u03b5\u03c1\u03ac\u03c3\u03b9\u03bc\u03bf\u03c2 \u1f41 \u1f38\u03bf\u03c1\u03b4\u03b1\u03bd\u03af\u03c4\u03b7\u03c2", "short": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0393\u03b5\u03c1\u03ac\u03c3\u03b9\u03bc\u03bf\u03c2 \u1f41 \u1f38\u03bf\u03c1\u03b4\u03b1\u03bd\u03af\u03c4\u03b7\u03c2"}}, "506": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u1f1c\u03c1\u03b1\u03c3\u03bc\u03bf\u03c2 \u1f10\u03ba \u1fec\u03c9\u03c3\u03af\u03b1\u03c2", "short": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u1f1c\u03c1\u03b1\u03c3\u03bc\u03bf\u03c2 \u1f10\u03ba \u1fec\u03c9\u03c3\u03af\u03b1\u03c2"}}, "508": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u03a4\u03b1\u03c1\u03ac\u03c3\u03b9\u03bf\u03c2 \u1f08\u03c1\u03c7\u03b9\u03b5\u03c0\u03af\u03c3\u03ba\u03bf\u03c0\u03bf\u03c2 \u039a\u03c9\u03bd\u03c3\u03c4\u03b1\u03bd\u03c4\u03b9\u03bd\u03bf\u03c5\u03c0\u03cc\u03bb\u03b5\u03c9\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u03a4\u03b1\u03c1\u03ac\u03c3\u03b9\u03bf\u03c2 \u1f08\u03c1\u03c7\u03b9\u03b5\u03c0\u03af\u03c3\u03ba\u03bf\u03c0\u03bf\u03c2 \u039a\u03c9\u03bd\u03c3\u03c4\u03b1\u03bd\u03c4\u03b9\u03bd\u03bf\u03c5\u03c0\u03cc\u03bb\u03b5\u03c9\u03c2"}}, "510": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u03a0\u03bf\u03c1\u03c6\u03cd\u03c1\u03b9\u03bf\u03c2 \u1f18\u03c0\u03af\u03c3\u03ba\u03bf\u03c0\u03bf\u03c2 \u0393\u03ac\u03b6\u03b7\u03c2", "short": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u03a0\u03bf\u03c1\u03c6\u03cd\u03c1\u03b9\u03bf\u03c2 \u1f18\u03c0\u03af\u03c3\u03ba\u03bf\u03c0\u03bf\u03c2 \u0393\u03ac\u03b6\u03b7\u03c2"}}, "512": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u03a3\u03b5\u03b2\u03b1\u03c3\u03c4\u03b9\u03b1\u03bd\u1f78\u03c2 \u1f41 \u03b4\u03bf\u1fe6\u03ba\u03b1\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u03a3\u03b5\u03b2\u03b1\u03c3\u03c4\u03b9\u03b1\u03bd\u1f78\u03c2", "genetive": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u03a3\u03b5\u03b2\u03b1\u03c3\u03c4\u03b9\u03b1\u03bd\u1f78\u03c2"}}, "518": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0398\u03b1\u03bb\u03bb\u03b5\u03bb\u03b1\u03af\u03bf\u03c2", "short": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0398\u03b1\u03bb\u03bb\u03b5\u03bb\u03b1\u03af\u03bf\u03c2"}}, "523": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0392\u03b1\u03c3\u03af\u03bb\u03b5\u03b9\u03bf\u03c2 \u1f41 \u1f49\u03bc\u03bf\u03bb\u03bf\u03b3\u03b7\u03c4\u1f74\u03c2", "short": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0392\u03b1\u03c3\u03af\u03bb\u03b5\u03b9\u03bf\u03c2 \u1f41 \u1f49\u03bc\u03bf\u03bb\u03bf\u03b3\u03b7\u03c4\u1f74\u03c2"}}, "526": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u03a0\u03c1\u03bf\u03c4\u03ad\u03c1\u03b9\u03bf\u03c2 \u1f41 \u1f31\u03b5\u03c1\u03bf\u03bc\u03ac\u03c1\u03c4\u03c5\u03c1\u03b1\u03c2 \u1f08\u03c1\u03c7\u03b9\u03b5\u03c0\u03af\u03c3\u03ba\u03bf\u03c0\u03bf\u03c2 \u1f08\u03bb\u03b5\u03be\u03b1\u03bd\u03b4\u03c1\u03b5\u03af\u03b1\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u03a0\u03c1\u03bf\u03c4\u03ad\u03c1\u03b9\u03bf\u03c2 \u1f41 \u1f31\u03b5\u03c1\u03bf\u03bc\u03ac\u03c1\u03c4\u03c5\u03c1\u03b1\u03c2 \u1f08\u03c1\u03c7\u03b9\u03b5\u03c0\u03af\u03c3\u03ba\u03bf\u03c0\u03bf\u03c2 \u1f08\u03bb\u03b5\u03be\u03b1\u03bd\u03b4\u03c1\u03b5\u03af\u03b1\u03c2"}}, "527": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u039d\u03ad\u03c3\u03c4\u03c9\u03c1\u03b1\u03c2 \u1f41 \u039c\u03ac\u03c1\u03c4\u03c5\u03c1\u03b1\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u039d\u03ad\u03c3\u03c4\u03c9\u03c1\u03b1\u03c2 \u1f41 \u039c\u03ac\u03c1\u03c4\u03c5\u03c1\u03b1\u03c2"}}, "528": {"name": {"nominative": "\u039f\u03c3\u03af\u03b5\u03c2 \u039c\u03b1\u03c1\u03ac\u03bd\u03b1 \u03ba\u03b1\u1f76 \u039a\u03cd\u03c1\u03b1", "short": "\u039f\u03c3\u03af\u03b5\u03c2 \u039c\u03b1\u03c1\u03ac\u03bd\u03b1 \u03ba\u03b1\u1f76 \u039a\u03cd\u03c1\u03b1"}}, "535": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u0393\u03c1\u03b7\u03b3\u03cc\u03c1\u03b9\u03bf\u03c2 \u1f41 \u0398\u03b5\u03bf\u03bb\u03cc\u03b3\u03bf\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u0393\u03c1\u03b7\u03b3\u03cc\u03c1\u03b9\u03bf\u03c2 \u1f41 \u0398\u03b5\u03bf\u03bb\u03cc\u03b3\u03bf\u03c2"}}, "536": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0393\u03c1\u03b7\u03b3\u03cc\u03c1\u03b9\u03bf\u03c2 \u1f41 \u0391\u0374 \u0394\u03b9\u03ac\u03bb\u03bf\u03b3\u03bf\u03c2 \u03a0\u03ac\u03c0\u03b1\u03c2 \u1fec\u03ce\u03bc\u03b7\u03c2", "short": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0393\u03c1\u03b7\u03b3\u03cc\u03c1\u03b9\u03bf\u03c2 \u1f41 \u0391\u0374 \u0394\u03b9\u03ac\u03bb\u03bf\u03b3\u03bf\u03c2 \u03a0\u03ac\u03c0\u03b1\u03c2 \u1fec\u03ce\u03bc\u03b7\u03c2"}}, "543": {"name": {"nominative": "\u0393\u03c1\u03b7\u03b3\u03bf\u03c1\u03af\u03bf\u03c5 \u03c4\u03bf\u1fe6 \u03a0\u03b1\u03bb\u03b1\u03bc\u1fb6", "short": "\u0393\u03c1\u03b7\u03b3\u03bf\u03c1\u03af\u03bf\u03c5 \u03c4\u03bf\u1fe6 \u03a0\u03b1\u03bb\u03b1\u03bc\u1fb6", "genetive": "\u0393\u03c1\u03b7\u03b3\u03bf\u03c1\u03af\u03bf\u03c5 \u03c4\u03bf\u1fe6 \u03a0\u03b1\u03bb\u03b1\u03bc\u1fb6"}}, "544": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u0398\u03b5\u03cc\u03b4\u03bf\u03c4\u03bf\u03c2 \u1f18\u03c0\u03af\u03c3\u03ba\u03bf\u03c0\u03bf\u03c2 \u039a\u03c5\u03c1\u03ae\u03bd\u03b5\u03b9\u03b1\u03c2 \u039a\u03cd\u03c0\u03c1\u03bf\u03c5 \u1f49\u03bc\u03bf\u03bb\u03bf\u03b3\u03b7\u03c4\u1f74\u03c2 \u03ba\u03b1\u1f76 \u1f31\u03b5\u03c1\u03bf\u03bc\u03ac\u03c1\u03c4\u03c5\u03c1\u03b1\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u0398\u03b5\u03cc\u03b4\u03bf\u03c4\u03bf\u03c2 \u1f18\u03c0\u03af\u03c3\u03ba\u03bf\u03c0\u03bf\u03c2 \u039a\u03c5\u03c1\u03ae\u03bd\u03b5\u03b9\u03b1\u03c2 \u039a\u03cd\u03c0\u03c1\u03bf\u03c5 \u1f49\u03bc\u03bf\u03bb\u03bf\u03b3\u03b7\u03c4\u1f74\u03c2 \u03ba\u03b1\u1f76 \u1f31\u03b5\u03c1\u03bf\u03bc\u03ac\u03c1\u03c4\u03c5\u03c1\u03b1\u03c2"}}, "545": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0393\u03c1\u03b7\u03b3\u03cc\u03c1\u03b9\u03bf\u03c2 \u1f41 \u1f1c\u03b3\u03ba\u03bb\u03b5\u03b9\u03c3\u03c4\u03bf\u03c2", "short": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0393\u03c1\u03b7\u03b3\u03cc\u03c1\u03b9\u03bf\u03c2 \u1f41 \u1f1c\u03b3\u03ba\u03bb\u03b5\u03b9\u03c3\u03c4\u03bf\u03c2"}}, "546": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u1f08\u03c1\u03c3\u03ad\u03bd\u03b9\u03bf\u03c2 \u1f18\u03c0\u03af\u03c3\u03ba\u03bf\u03c0\u03bf\u03c2 \u03a4\u03b2\u1f72\u03c1 \u03c4\u1fc6\u03c2 \u1fec\u03c9\u03c3\u03af\u03b1\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u1f08\u03c1\u03c3\u03ad\u03bd\u03b9\u03bf\u03c2 \u1f18\u03c0\u03af\u03c3\u03ba\u03bf\u03c0\u03bf\u03c2 \u03a4\u03b2\u1f72\u03c1 \u03c4\u1fc6\u03c2 \u1fec\u03c9\u03c3\u03af\u03b1\u03c2"}}, "551": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u0393\u03c1\u03b7\u03b3\u03cc\u03c1\u03b9\u03bf\u03c2 \u039d\u03b5\u03bf\u03ba\u03b1\u03b9\u03c3\u03b1\u03c1\u03b5\u03af\u03b1\u03c2 \u1f41 \u0398\u03b1\u03c5\u03bc\u03b1\u03c4\u03bf\u03c5\u03c1\u03b3\u1f78\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u0393\u03c1\u03b7\u03b3\u03cc\u03c1\u03b9\u03bf\u03c2 \u039d\u03b5\u03bf\u03ba\u03b1\u03b9\u03c3\u03b1\u03c1\u03b5\u03af\u03b1\u03c2 \u1f41 \u0398\u03b1\u03c5\u03bc\u03b1\u03c4\u03bf\u03c5\u03c1\u03b3\u1f78\u03c2"}}, "552": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03b9 \u0393\u03bf\u03c5\u03c1\u03af\u03b1\u03c2, \u03a3\u03b1\u03bc\u03c9\u03bd\u1f70\u03c2 \u03ba\u03b1\u1f76 \u1f0c\u03b2\u03b9\u03b2\u03bf\u03c2 \u03bf\u1f31 \u1f49\u03bc\u03bf\u03bb\u03bf\u03b3\u03b7\u03c4\u1f72\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03b9 \u0393\u03bf\u03c5\u03c1\u03af\u03b1\u03c2, \u03a3\u03b1\u03bc\u03c9\u03bd\u1f70\u03c2 \u03ba\u03b1\u1f76 \u1f0c\u03b2\u03b9\u03b2\u03bf\u03c2 \u03bf\u1f31 \u1f49\u03bc\u03bf\u03bb\u03bf\u03b3\u03b7\u03c4\u1f72\u03c2"}}, "553": {"name": {"nominative": "\u03a3\u03cd\u03bd\u03b1\u03be\u03b9\u03c2 \u03c4\u1fc6\u03c2 \u1f59\u03c0\u03b5\u03c1\u03b1\u03b3\u03af\u03b1\u03c2 \u0398\u03b5\u03bf\u03c4\u03cc\u03ba\u03bf\u03c5 \u03c4\u1fc6\u03c2 \u1f18\u03bd\u03b8\u03c1\u03cc\u03bd\u03bf\u03c5", "short": "\u03a3\u03cd\u03bd\u03b1\u03be\u03b9\u03c2 \u03c4\u1fc6\u03c2 \u1f59\u03c0\u03b5\u03c1\u03b1\u03b3\u03af\u03b1\u03c2 \u0398\u03b5\u03bf\u03c4\u03cc\u03ba\u03bf\u03c5 \u03c4\u1fc6\u03c2 \u1f18\u03bd\u03b8\u03c1\u03cc\u03bd\u03bf\u03c5"}}, "555": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03b9 \u0395\u1f50\u03c4\u03c1\u03cc\u03c0\u03b9\u03bf\u03c2 , \u039a\u03bb\u03b5\u03cc\u03bd\u03b9\u03ba\u03bf\u03c2 \u03ba\u03b1\u1f76 \u0392\u03b1\u03c3\u03b9\u03bb\u03af\u03c3\u03ba\u03bf\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03b9 \u0395\u1f50\u03c4\u03c1\u03cc\u03c0\u03b9\u03bf\u03c2 , \u039a\u03bb\u03b5\u03cc\u03bd\u03b9\u03ba\u03bf\u03c2 \u03ba\u03b1\u1f76 \u0392\u03b1\u03c3\u03b9\u03bb\u03af\u03c3\u03ba\u03bf\u03c2"}}, "556": {"name": {"nominative": "\u1f49\u03c3\u03af\u03b1 \u03a0\u03b9\u03b1\u03bc\u03bf\u1fe6\u03bd \u1f21 \u03a0\u03b1\u03c1\u03b8\u03ad\u03bd\u03bf\u03c2", "short": "\u1f49\u03c3\u03af\u03b1 \u03a0\u03b9\u03b1\u03bc\u03bf\u1fe6\u03bd \u1f21 \u03a0\u03b1\u03c1\u03b8\u03ad\u03bd\u03bf\u03c2"}}, "557": {"name": {"nominative": "\u03a3\u03cd\u03bd\u03b1\u03be\u03b9\u03c2 \u03c4\u1fc6\u03c2 \u1f59\u03c0\u03b5\u03c1\u03b1\u03b3\u03af\u03b1\u03c2 \u0398\u03b5\u03bf\u03c4\u03cc\u03ba\u03bf\u03c5 \u03c4\u03bf\u1fe6 \u0392\u03bf\u03bb\u03bf\u03ba\u03bf\u03bb\u1f70\u03bc\u03c3\u03ba \u1f10\u03bd \u1fec\u03c9\u03c3\u03af\u1fb3", "short": "\u03a3\u03cd\u03bd\u03b1\u03be\u03b9\u03c2 \u03c4\u1fc6\u03c2 \u1f59\u03c0\u03b5\u03c1\u03b1\u03b3\u03af\u03b1\u03c2 \u0398\u03b5\u03bf\u03c4\u03cc\u03ba\u03bf\u03c5 \u03c4\u03bf\u1fe6 \u0392\u03bf\u03bb\u03bf\u03ba\u03bf\u03bb\u1f70\u03bc\u03c3\u03ba \u1f10\u03bd \u1fec\u03c9\u03c3\u03af\u1fb3"}}, "564": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03b9 \u03a0\u03b1\u1fe6\u03bb\u03bf\u03c2 \u03ba\u03b1\u1f76 \u1f38\u03bf\u03c5\u03bb\u03b9\u03b1\u03bd\u1f74 \u03ba\u03b1\u1f76 \u03bf\u1f31 \u03bc\u03b1\u03b6\u1f76 \u03bc\u0374 \u03b1\u1f50\u03c4\u03bf\u1f7a\u03c2 \u03bc\u03b1\u03c1\u03c4\u03c5\u03c1\u03ae\u03c3\u03b1\u03bd\u03c4\u03b5\u03c2 \u03a3\u03c4\u03c1\u03b1\u03c4\u03cc\u03bd\u03b9\u03ba\u03bf\u03c2, \u039a\u03bf\u03b4\u03c1\u1fb6\u03c4\u03bf\u03c2 \u03ba\u03b1\u1f76 \u1f08\u03ba\u03ac\u03ba\u03b9\u03bf\u03c2 \u03bf\u1f31 \u03b4\u03ae\u03bc\u03b9\u03bf\u03b9", "short": "\u1f0d\u03b3\u03b9\u03bf\u03b9 \u03a0\u03b1\u1fe6\u03bb\u03bf\u03c2 \u03ba\u03b1\u1f76 \u1f38\u03bf\u03c5\u03bb\u03b9\u03b1\u03bd\u1f74 \u03ba\u03b1\u1f76 \u03bf\u1f31 \u03bc\u03b1\u03b6\u1f76 \u03bc\u0374 \u03b1\u1f50\u03c4\u03bf\u1f7a\u03c2 \u03bc\u03b1\u03c1\u03c4\u03c5\u03c1\u03ae\u03c3\u03b1\u03bd\u03c4\u03b5\u03c2 \u03a3\u03c4\u03c1\u03b1\u03c4\u03cc\u03bd\u03b9\u03ba\u03bf\u03c2, \u039a\u03bf\u03b4\u03c1\u1fb6\u03c4\u03bf\u03c2 \u03ba\u03b1\u1f76 \u1f08\u03ba\u03ac\u03ba\u03b9\u03bf\u03c2 \u03bf\u1f31 \u03b4\u03ae\u03bc\u03b9\u03bf\u03b9"}}, "567": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u039a\u03cc\u03bd\u03c9\u03bd \u1f41 \u1f3c\u03c3\u03b1\u03c5\u03c1\u03bf\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u039a\u03cc\u03bd\u03c9\u03bd \u1f41 \u1f3c\u03c3\u03b1\u03c5\u03c1\u03bf\u03c2"}}, "570": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u039a\u03cc\u03bd\u03c9\u03bd \u1f41 \u039a\u03b7\u03c0\u03bf\u03c5\u03c1\u1f78\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u039a\u03cc\u03bd\u03c9\u03bd \u1f41 \u039a\u03b7\u03c0\u03bf\u03c5\u03c1\u1f78\u03c2"}}, "571": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u0395\u1f50\u03bb\u03cc\u03b3\u03b9\u03bf\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u0395\u1f50\u03bb\u03cc\u03b3\u03b9\u03bf\u03c2"}}, "572": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u0395\u1f50\u03bb\u03ac\u03bc\u03c0\u03b9\u03bf\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u0395\u1f50\u03bb\u03ac\u03bc\u03c0\u03b9\u03bf\u03c2"}}, "575": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u1f29\u03c3\u03cd\u03c7\u03b9\u03bf\u03c2 \u1f41 \u0398\u03b1\u03c5\u03bc\u03b1\u03c4\u03bf\u03c5\u03c1\u03b3\u1f78\u03c2", "short": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u1f29\u03c3\u03cd\u03c7\u03b9\u03bf\u03c2 \u1f41 \u0398\u03b1\u03c5\u03bc\u03b1\u03c4\u03bf\u03c5\u03c1\u03b3\u1f78\u03c2"}}, "579": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u0394\u03b1\u03bd\u03b9\u1f74\u03bb \u1f41 \u03a0\u03c1\u03af\u03b3\u03ba\u03b9\u03c0\u03b1\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u0394\u03b1\u03bd\u03b9\u1f74\u03bb \u1f41 \u03a0\u03c1\u03af\u03b3\u03ba\u03b9\u03c0\u03b1\u03c2"}}, "583": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u1f08\u03c1\u03ba\u03ac\u03b4\u03b9\u03bf\u03c2", "short": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u1f08\u03c1\u03ba\u03ac\u03b4\u03b9\u03bf\u03c2"}}, "584": {"name": {"nominative": "\u03a3\u03cd\u03bd\u03b1\u03be\u03b9\u03c2 \u03c4\u1fc6\u03c2 \u1f59\u03c0\u03b5\u03c1\u03b1\u03b3\u03af\u03b1\u03c2 \u0398\u03b5\u03bf\u03c4\u03cc\u03ba\u03bf\u03c5 \u03c4\u1fc6\u03c2 \u03a4\u03c3\u03b6\u03b5\u03c3\u03c4\u03cc\u03ba\u03bf\u03b2\u03b1 \u1f10\u03bd \u1fec\u03c9\u03c3\u03af\u1fb3", "short": "\u03a3\u03cd\u03bd\u03b1\u03be\u03b9\u03c2 \u03c4\u1fc6\u03c2 \u1f59\u03c0\u03b5\u03c1\u03b1\u03b3\u03af\u03b1\u03c2 \u0398\u03b5\u03bf\u03c4\u03cc\u03ba\u03bf\u03c5 \u03c4\u1fc6\u03c2 \u03a4\u03c3\u03b6\u03b5\u03c3\u03c4\u03cc\u03ba\u03bf\u03b2\u03b1 \u1f10\u03bd \u1fec\u03c9\u03c3\u03af\u1fb3"}}, "585": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0394\u03b1\u03bd\u03b9\u1f74\u03bb \u1f41 \u03a3\u03c4\u03c5\u03bb\u03af\u03c4\u03b7\u03c2", "short": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0394\u03b1\u03bd\u03b9\u1f74\u03bb \u1f41 \u03a3\u03c4\u03c5\u03bb\u03af\u03c4\u03b7\u03c2"}}, "588": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03b9 \u1f18\u03c6\u03c1\u03b1\u1f76\u03bc, \u0392\u03b1\u03c3\u03b9\u03bb\u03b5\u03cd\u03c2, \u0395\u1f50\u03b3\u03ad\u03bd\u03b9\u03bf\u03c2, \u1f08\u03b3\u03b1\u03b8\u03cc\u03b4\u03c9\u03c1\u03bf\u03c2, \u1f18\u03bb\u03c0\u03af\u03b4\u03b9\u03bf\u03c2, \u039a\u03b1\u03c0\u03af\u03c4\u03c9\u03bd \u03ba\u03b1\u1f76 \u0391\u1f30\u03b8\u03ad\u03c1\u03b9\u03bf\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03b9 \u1f18\u03c6\u03c1\u03b1\u1f76\u03bc, \u0392\u03b1\u03c3\u03b9\u03bb\u03b5\u03cd\u03c2, \u0395\u1f50\u03b3\u03ad\u03bd\u03b9\u03bf\u03c2, \u1f08\u03b3\u03b1\u03b8\u03cc\u03b4\u03c9\u03c1\u03bf\u03c2, \u1f18\u03bb\u03c0\u03af\u03b4\u03b9\u03bf\u03c2, \u039a\u03b1\u03c0\u03af\u03c4\u03c9\u03bd \u03ba\u03b1\u1f76 \u0391\u1f30\u03b8\u03ad\u03c1\u03b9\u03bf\u03c2"}}, "590": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03b9 \u0391\u1f30\u03bc\u03b9\u03bb\u03b9\u03b1\u03bd\u1f78\u03c2 \u1f41 \u1fec\u03c9\u03bc\u03b1\u1fd6\u03bf\u03c2 \u03ba\u03b1\u1f76 \u03bf\u1f31 \u03c3\u1f7a\u03bd \u03b1\u1f50\u03c4\u1ff7 \u1f38\u03ac\u03ba\u03c9\u03b2\u03bf\u03c2 \u03ba\u03b1\u1f76 \u039c\u03b1\u03c1\u03b9\u03b1\u03bd\u1f78\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03b9 \u0391\u1f30\u03bc\u03b9\u03bb\u03b9\u03b1\u03bd\u1f78\u03c2 \u1f41 \u1fec\u03c9\u03bc\u03b1\u1fd6\u03bf\u03c2 \u03ba\u03b1\u1f76 \u03bf\u1f31 \u03c3\u1f7a\u03bd \u03b1\u1f50\u03c4\u1ff7 \u1f38\u03ac\u03ba\u03c9\u03b2\u03bf\u03c2 \u03ba\u03b1\u1f76 \u039c\u03b1\u03c1\u03b9\u03b1\u03bd\u1f78\u03c2"}}, "592": {"name": {"nominative": "\u03a3\u03cd\u03bd\u03b1\u03be\u03b9\u03c2 \u03c4\u1fc6\u03c2 \u1f59\u03c0\u03b5\u03c1\u03b1\u03b3\u03af\u03b1\u03c2 \u0398\u03b5\u03bf\u03c4\u03cc\u03ba\u03bf\u03c5 \u1f21 \u1f18\u03b3\u03b3\u03cd\u03b7\u03c3\u03b7 \u03c4\u1ff6\u03bd \u1f09\u03bc\u03b1\u03c1\u03c4\u03c9\u03bb\u1ff6\u03bd", "short": "\u03a3\u03cd\u03bd\u03b1\u03be\u03b9\u03c2 \u03c4\u1fc6\u03c2 \u1f59\u03c0\u03b5\u03c1\u03b1\u03b3\u03af\u03b1\u03c2 \u0398\u03b5\u03bf\u03c4\u03cc\u03ba\u03bf\u03c5 \u1f21 \u1f18\u03b3\u03b3\u03cd\u03b7\u03c3\u03b7 \u03c4\u1ff6\u03bd \u1f09\u03bc\u03b1\u03c1\u03c4\u03c9\u03bb\u1ff6\u03bd"}}, "594": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0398\u03b5\u03bf\u03c6\u03cd\u03bb\u03b1\u03ba\u03c4\u03bf\u03c2 \u1f18\u03c0\u03af\u03c3\u03ba\u03bf\u03c0\u03bf\u03c2 \u039d\u03b9\u03ba\u03bf\u03bc\u03ae\u03b4\u03b5\u03b9\u03b1\u03c2", "short": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0398\u03b5\u03bf\u03c6\u03cd\u03bb\u03b1\u03ba\u03c4\u03bf\u03c2 \u1f18\u03c0\u03af\u03c3\u03ba\u03bf\u03c0\u03bf\u03c2 \u039d\u03b9\u03ba\u03bf\u03bc\u03ae\u03b4\u03b5\u03b9\u03b1\u03c2"}}, "50201": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03b9 \u0393\u03b5\u03c1\u03ac\u03c3\u03b9\u03bc\u03bf\u03c2, \u1f38\u03c9\u03bd\u1fb6\u03c2 \u03ba\u03b1\u1f76 \u03a0\u03b9\u03c4\u03b9\u03c1\u1f76\u03bc \u1f10\u03ba \u1fec\u03c9\u03c3\u03af\u03b1\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03b9 \u0393\u03b5\u03c1\u03ac\u03c3\u03b9\u03bc\u03bf\u03c2, \u1f38\u03c9\u03bd\u1fb6\u03c2 \u03ba\u03b1\u1f76 \u03a0\u03b9\u03c4\u03b9\u03c1\u1f76\u03bc \u1f10\u03ba \u1fec\u03c9\u03c3\u03af\u03b1\u03c2"}}, "53901": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0393\u03c1\u03b7\u03b3\u03cc\u03c1\u03b9\u03bf\u03c2 \u1f41 \u0394\u03b5\u03ba\u03b1\u03c0\u03bf\u03bb\u03af\u03c4\u03b7\u03c2", "short": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0393\u03c1\u03b7\u03b3\u03cc\u03c1\u03b9\u03bf\u03c2 \u1f41 \u0394\u03b5\u03ba\u03b1\u03c0\u03bf\u03bb\u03af\u03c4\u03b7\u03c2"}}, "54301": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u0393\u03c1\u03b7\u03b3\u03cc\u03c1\u03b9\u03bf\u03c2 \u1f41 \u03a0\u03b1\u03bb\u03b1\u03bc\u1fb6\u03c2 \u1f08\u03c1\u03c7\u03b9\u03b5\u03c0\u03af\u03c3\u03ba\u03bf\u03c0\u03bf\u03c2 \u0398\u03b5\u03c3\u03c3\u03b1\u03bb\u03bf\u03bd\u03af\u03ba\u03b7\u03c2, \u1f41 \u0398\u03b1\u03c5\u03bc\u03b1\u03c4\u03bf\u03c5\u03c1\u03b3\u1f78\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u0393\u03c1\u03b7\u03b3\u03cc\u03c1\u03b9\u03bf\u03c2 \u1f41 \u03a0\u03b1\u03bb\u03b1\u03bc\u1fb6\u03c2 \u1f08\u03c1\u03c7\u03b9\u03b5\u03c0\u03af\u03c3\u03ba\u03bf\u03c0\u03bf\u03c2 \u0398\u03b5\u03c3\u03c3\u03b1\u03bb\u03bf\u03bd\u03af\u03ba\u03b7\u03c2, \u1f41 \u0398\u03b1\u03c5\u03bc\u03b1\u03c4\u03bf\u03c5\u03c1\u03b3\u1f78\u03c2"}}, "54401": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0393\u03c1\u03b7\u03b3\u03cc\u03c1\u03b9\u03bf\u03c2 \u1f10\u03bd \u03c4\u1ff7 \u03c0\u03bf\u03c4\u03b1\u03bc\u1ff7 \u03a0\u03b5\u03c3\u03cc\u03bc\u03b1", "short": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0393\u03c1\u03b7\u03b3\u03cc\u03c1\u03b9\u03bf\u03c2 \u1f10\u03bd \u03c4\u1ff7 \u03c0\u03bf\u03c4\u03b1\u03bc\u1ff7 \u03a0\u03b5\u03c3\u03cc\u03bc\u03b1"}}, "54501": {"name": {"nominative": "\u1f09\u03b3\u03af\u03b1 \u0395\u1f50\u03b8\u03b1\u03bb\u03af\u03b1 \u1f21 \u03c0\u03b1\u03c1\u03b8\u03b5\u03bd\u03bf\u03bc\u03ac\u03c1\u03c4\u03c5\u03c2", "short": "\u1f09\u03b3\u03af\u03b1 \u0395\u1f50\u03b8\u03b1\u03bb\u03af\u03b1 \u1f21 \u03c0\u03b1\u03c1\u03b8\u03b5\u03bd\u03bf\u03bc\u03ac\u03c1\u03c4\u03c5\u03c2"}}, "55302": {"name": {"nominative": "\u1f08\u03bd\u03b1\u03ba\u03bf\u03bc\u03b9\u03b4\u1f74 \u1f31\u03b5\u03c1\u1ff6\u03bd \u039b\u03b5\u03b9\u03c8\u03ac\u03bd\u03c9\u03bd \u03c4\u03bf\u1fe6 \u1f09\u03b3\u03af\u03bf\u03c5 \u0393\u03bf\u03c5\u03c1\u03af\u03b1", "short": "\u1f08\u03bd\u03b1\u03ba\u03bf\u03bc\u03b9\u03b4\u1f74 \u1f31\u03b5\u03c1\u1ff6\u03bd \u039b\u03b5\u03b9\u03c8\u03ac\u03bd\u03c9\u03bd \u03c4\u03bf\u1fe6 \u1f09\u03b3\u03af\u03bf\u03c5 \u0393\u03bf\u03c5\u03c1\u03af\u03b1"}}, "57901": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03b9 \u1f08\u03ad\u03c4\u03b9\u03bf\u03c2, \u0392\u03b1\u03c3\u03c3\u03cc\u03b7\u03c2, \u0398\u03b5\u03cc\u03b4\u03c9\u03c1\u03bf\u03c2, \u0398\u03b5\u03cc\u03c6\u03b9\u03bb\u03bf\u03c2, \u039a\u03ac\u03bb\u03bb\u03b9\u03c3\u03c4\u03bf\u03c2, \u039a\u03c9\u03bd\u03c3\u03c4\u03b1\u03bd\u03c4\u1fd6\u03bd\u03bf\u03c2 \u03ba\u03b1\u1f76 \u1f04\u03bb\u03bb\u03bf\u03b9 36 \u039c\u03ac\u03c1\u03c4\u03c5\u03c1\u03b5\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03b9 \u1f08\u03ad\u03c4\u03b9\u03bf\u03c2, \u0392\u03b1\u03c3\u03c3\u03cc\u03b7\u03c2, \u0398\u03b5\u03cc\u03b4\u03c9\u03c1\u03bf\u03c2, \u0398\u03b5\u03cc\u03c6\u03b9\u03bb\u03bf\u03c2, \u039a\u03ac\u03bb\u03bb\u03b9\u03c3\u03c4\u03bf\u03c2, \u039a\u03c9\u03bd\u03c3\u03c4\u03b1\u03bd\u03c4\u1fd6\u03bd\u03bf\u03c2 \u03ba\u03b1\u1f76 \u1f04\u03bb\u03bb\u03bf\u03b9 36 \u039c\u03ac\u03c1\u03c4\u03c5\u03c1\u03b5\u03c2"}}, "58201": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0394\u03b1\u03bd\u03b9\u1f74\u03bb \u1f41 \u03b8\u03b1\u03c5\u03bc\u03b1\u03c4\u03bf\u03c5\u03c1\u03b3\u1f78\u03c2", "short": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0394\u03b1\u03bd\u03b9\u1f74\u03bb \u1f41 \u03b8\u03b1\u03c5\u03bc\u03b1\u03c4\u03bf\u03c5\u03c1\u03b3\u1f78\u03c2"}}}