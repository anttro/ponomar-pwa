f\u03c0\u03bf\u03bb\u03af\u03c4\u03b7 \u039c\u03cc\u03c3\u03c7\u03b1\u03c2", "short": "\u1f08\u03bd\u03b1\u03ba\u03bf\u03bc\u03b9\u03b4\u1f74 \u1f31\u03b5\u03c1\u1ff6\u03bd \u039b\u03b5\u03b9\u03c8\u03ac\u03bd\u03c9\u03bd \u03c4\u03bf\u1fe6 \u1f09\u03b3\u03af\u03bf\u03c5 \u1f38\u1f7c\u03b2 \u039c\u03b7\u03c4\u03c1\u03bf\u03c0\u03bf\u03bb\u03af\u03c4\u03b7 \u039c\u03cc\u03c3\u03c7\u03b1\u03c2"}}, "6649": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u1f38\u1f7c\u03b2 \u1f41 \u1f18\u03c1\u03b7\u03bc\u03af\u03c4\u03b7\u03c2", "short": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u1f38\u1f7c\u03b2 \u1f41 \u1f18\u03c1\u03b7\u03bc\u03af\u03c4\u03b7\u03c2"}}, "6661": {"name": {"nominative": "\u1f09\u03b3\u03af\u03b5\u03c2 \u039a\u03b1\u03c0\u03b5\u03c4\u03c9\u03bb\u03af\u03bd\u03b1 \u03ba\u03b1\u1f76 \u1f18\u03c1\u03c9\u03c4\u03b7\u0390\u03b4\u03b1", "short": "\u1f09\u03b3\u03af\u03b5\u03c2 \u039a\u03b1\u03c0\u03b5\u03c4\u03c9\u03bb\u03af\u03bd\u03b1 \u03ba\u03b1\u1f76 \u1f18\u03c1\u03c9\u03c4\u03b7\u0390\u03b4\u03b1"}}, "6673": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u1f08\u03c1\u03c4\u03ad\u03bc\u03c9\u03bd \u1f18\u03c0\u03af\u03c3\u03ba\u03bf\u03c0\u03bf\u03c2 \u03a3\u03b5\u03bb\u03b5\u03c5\u03ba\u03b5\u03af\u03b1\u03c2 \u03c4\u1fc6\u03c2 \u03a0\u03b9\u03c3\u03b9\u03b4\u03af\u03b1\u03c2", "short": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u1f08\u03c1\u03c4\u03ad\u03bc\u03c9\u03bd \u1f18\u03c0\u03af\u03c3\u03ba\u03bf\u03c0\u03bf\u03c2 \u03a3\u03b5\u03bb\u03b5\u03c5\u03ba\u03b5\u03af\u03b1\u03c2 \u03c4\u1fc6\u03c2 \u03a0\u03b9\u03c3\u03b9\u03b4\u03af\u03b1\u03c2"}}, "6711": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u039c\u03b1\u03ba\u03ac\u03c1\u03b9\u03bf\u03c2 \u039c\u03b7\u03c4\u03c1\u03bf\u03c0\u03bf\u03bb\u03af\u03c4\u03b7\u03c2 \u039c\u03cc\u03c3\u03c7\u03b1\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u039c\u03b1\u03ba\u03ac\u03c1\u03b9\u03bf\u03c2 \u039c\u03b7\u03c4\u03c1\u03bf\u03c0\u03bf\u03bb\u03af\u03c4\u03b7\u03c2 \u039c\u03cc\u03c3\u03c7\u03b1\u03c2"}}, "6715": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u039c\u03b1\u03ba\u03ac\u03c1\u03b9\u03bf\u03c2 \u1f41 \u1fec\u03c9\u03bc\u03b1\u1fd6\u03bf\u03c2", "short": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u039c\u03b1\u03ba\u03ac\u03c1\u03b9\u03bf\u03c2 \u1f41 \u1fec\u03c9\u03bc\u03b1\u1fd6\u03bf\u03c2"}}, "6732": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03b9 \u039c\u03b1\u03c1\u03c4\u03cd\u03c1\u03b9\u03bf\u03c2 \u1f41 \u1f1c\u03b3\u03ba\u03bb\u03b5\u03b9\u03c3\u03c4\u03bf\u03c2\u03ba\u03b1\u1f76 \u039c\u03b1\u03c1\u03c4\u03cd\u03c1\u03b9\u03bf\u03c2 \u1f41 \u03b4\u03b9\u03ac\u03ba\u03bf\u03bd\u03bf\u03c2", "short": "\u1f4d\u03c3\u03b9\u03bf\u03b9 \u039c\u03b1\u03c1\u03c4\u03cd\u03c1\u03b9\u03bf\u03c2 \u1f41 \u1f1c\u03b3\u03ba\u03bb\u03b5\u03b9\u03c3\u03c4\u03bf\u03c2\u03ba\u03b1\u1f76 \u039c\u03b1\u03c1\u03c4\u03cd\u03c1\u03b9\u03bf\u03c2 \u1f41 \u03b4\u03b9\u03ac\u03ba\u03bf\u03bd\u03bf\u03c2"}}, "6759": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u039d\u03b9\u03ba\u03ae\u03c4\u03b1\u03c2 \u1f41 \u03a3\u03c4\u03c5\u03bb\u03af\u03c4\u03b7\u03c2 \u03a0\u03c1\u03b5\u03c3\u03bb\u03b1\u03b2\u03af\u03b1\u03c2 \u1f41 \u0398\u03b1\u03c5\u03bc\u03b1\u03c4\u03bf\u03c5\u03c1\u03b3\u1f78\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u039d\u03b9\u03ba\u03ae\u03c4\u03b1\u03c2 \u1f41 \u03a3\u03c4\u03c5\u03bb\u03af\u03c4\u03b7\u03c2 \u03a0\u03c1\u03b5\u03c3\u03bb\u03b1\u03b2\u03af\u03b1\u03c2 \u1f41 \u0398\u03b1\u03c5\u03bc\u03b1\u03c4\u03bf\u03c5\u03c1\u03b3\u1f78\u03c2"}}, "6782": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u03a0\u03b1\u0390\u03c3\u03b9\u03bf\u03c2 \u0392\u03b5\u03bb\u03b9\u03c4\u03c3\u03ba\u03cc\u03c6\u03c3\u03ba\u03c5", "short": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u03a0\u03b1\u0390\u03c3\u03b9\u03bf\u03c2 \u0392\u03b5\u03bb\u03b9\u03c4\u03c3\u03ba\u03cc\u03c6\u03c3\u03ba\u03c5"}}, "6783": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u03a0\u03b1\u0390\u03c3\u03b9\u03bf\u03c2 \u03c4\u03bf\u1fe6 \u0393\u03ba\u03b1\u03bb\u1f76\u03c4\u03c2", "short": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u03a0\u03b1\u0390\u03c3\u03b9\u03bf\u03c2 \u03c4\u03bf\u1fe6 \u0393\u03ba\u03b1\u03bb\u1f76\u03c4\u03c2"}}, "6785": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u03a0\u03b1\u0390\u03c3\u03b9\u03bf\u03c2 \u03c4\u03bf\u1fe6 \u039f\u1f54\u03b3\u03ba\u03bb\u03b9\u03c7", "short": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u03a0\u03b1\u0390\u03c3\u03b9\u03bf\u03c2 \u03c4\u03bf\u1fe6 \u039f\u1f54\u03b3\u03ba\u03bb\u03b9\u03c7"}}, "6800": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0392\u03b1\u03c1\u03bd\u03ac\u03b2\u03b1\u03c2 \u03c4\u03bf\u1fe6 \u03c0\u03bf\u03c4\u03b1\u03bc\u03bf\u03cd \u0392\u03b5\u03c4\u03bf\u03bb\u03bf\u03cd\u03b3\u03ba\u03b1", "short": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0392\u03b1\u03c1\u03bd\u03ac\u03b2\u03b1\u03c2 \u03c4\u03bf\u1fe6 \u03c0\u03bf\u03c4\u03b1\u03bc\u03bf\u03cd \u0392\u03b5\u03c4\u03bf\u03bb\u03bf\u03cd\u03b3\u03ba\u03b1"}}, "6832": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u03a3\u03ad\u03c1\u03b3\u03b9\u03bf\u03c2 \u1f41 \u1f10\u03bd \u03c4\u1ff7 \u03a3\u03c0\u03b7\u03bb\u03b1\u03af\u1ff3", "short": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u03a3\u03ad\u03c1\u03b3\u03b9\u03bf\u03c2 \u1f41 \u1f10\u03bd \u03c4\u1ff7 \u03a3\u03c0\u03b7\u03bb\u03b1\u03af\u1ff3"}}, "6865": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u03a4\u03af\u03c4\u03bf\u03c2 \u1f41 \u03c3\u03c4\u03c1\u03b1\u03c4\u03b9\u03ce\u03c4\u03b7\u03c2", "short": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u03a4\u03af\u03c4\u03bf\u03c2 \u1f41 \u03c3\u03c4\u03c1\u03b1\u03c4\u03b9\u03ce\u03c4\u03b7\u03c2"}}, "6916": {"name": {"nominative": "\u039c\u03b5\u03c4\u03b1\u03ba\u03bf\u03bc\u03b9\u03b4\u1f74 \u03c4\u1ff6\u03bd \u1f31\u03b5\u03c1\u1ff6\u03bd \u03bb\u03b5\u03b9\u03c8\u03ac\u03bd\u03c9\u03bd \u03c4\u03bf\u1fe6 \u1f09\u03b3\u03af\u03bf\u03c5 \u039d\u03b9\u03ba\u03bf\u03bb\u03ac\u03bf\u03c5 \u1f18\u03c0\u03b9\u03c3\u03ba\u03cc\u03c0\u03bf\u03c5 \u1f08\u03c7\u03c1\u03af\u03b4\u03bf\u03c2 \u03ba\u03b1\u1f76 \u0396\u03af\u03c4\u03c3\u03b7\u03c2", "short": "\u039c\u03b5\u03c4\u03b1\u03ba\u03bf\u03bc\u03b9\u03b4\u1f74 \u03c4\u1ff6\u03bd \u1f31\u03b5\u03c1\u1ff6\u03bd \u03bb\u03b5\u03b9\u03c8\u03ac\u03bd\u03c9\u03bd \u03c4\u03bf\u1fe6 \u1f09\u03b3\u03af\u03bf\u03c5 \u039d\u03b9\u03ba\u03bf\u03bb\u03ac\u03bf\u03c5 \u1f18\u03c0\u03b9\u03c3\u03ba\u03cc\u03c0\u03bf\u03c5 \u1f08\u03c7\u03c1\u03af\u03b4\u03bf\u03c2 \u03ba\u03b1\u1f76 \u0396\u03af\u03c4\u03c3\u03b7\u03c2"}}, "6920": {"name": {"nominative": "\u1f08\u03bd\u03b1\u03ba\u03bf\u03bc\u03b9\u03b4\u1f74 \u03c4\u1ff6\u03bd \u1f31\u03b5\u03c1\u1ff6\u03bd \u03bb\u03b5\u03b9\u03c8\u03ac\u03bd\u03c9\u03bd \u03c4\u03bf\u1fe6 \u1f49\u03c3\u03af\u03bf\u03c5 \u03c0\u03b1\u03c4\u03c1\u1f78\u03c2 \u1f38\u03c9\u03b1\u03bd\u03bd\u03b9\u03ba\u03af\u03bf\u03c5 \u03c4\u03bf\u1fe6 \u1f08\u03bd\u03b1\u03c7\u03c9\u03c1\u03b7\u03c4\u03bf\u1fe6 \u03c4\u03bf\u1fe6 \u1f10\u03ba \u03a3\u03b5\u03c1\u03b2\u03af\u03b1\u03c2", "short": "\u1f08\u03bd\u03b1\u03ba\u03bf\u03bc\u03b9\u03b4\u1f74 \u03c4\u1ff6\u03bd \u1f31\u03b5\u03c1\u1ff6\u03bd \u03bb\u03b5\u03b9\u03c8\u03ac\u03bd\u03c9\u03bd \u03c4\u03bf\u1fe6 \u1f49\u03c3\u03af\u03bf\u03c5 \u03c0\u03b1\u03c4\u03c1\u1f78\u03c2 \u1f38\u03c9\u03b1\u03bd\u03bd\u03b9\u03ba\u03af\u03bf\u03c5 \u03c4\u03bf\u1fe6 \u1f08\u03bd\u03b1\u03c7\u03c9\u03c1\u03b7\u03c4\u03bf\u1fe6 \u03c4\u03bf\u1fe6 \u1f10\u03ba \u03a3\u03b5\u03c1\u03b2\u03af\u03b1\u03c2"}}, "6922": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03b9 \u0391\u03ba\u03ac\u03ba\u03bf\u03c2 \u1f41 \u1f49\u03c3\u03b9\u03bf\u03bc\u03ac\u03c1\u03c4\u03c5\u03c1\u03b1\u03c2 \u1f00\u03c0\u1f78 \u03c4\u1f78 \u039d\u03b5\u03bf\u03c7\u03ce\u03c1\u03b9 \u0398\u03b5\u03c3\u03c3\u03b1\u03bb\u03bf\u03bd\u03af\u03ba\u03b7\u03c2, \u0395\u1f50\u03b8\u03cd\u03bc\u03b9\u03bf\u03c2 \u1f41 \u03a0\u03b5\u03bb\u03bf\u03c0\u03bf\u03bd\u03bd\u03ae\u03c3\u03b9\u03bf\u03c2 \u03ba\u03b1\u1f76 \u1f38\u03b3\u03bd\u03ac\u03c4\u03b9\u03bf\u03c2 \u1f41 \u03bd\u03ad\u03bf\u03c2 \u1f49\u03c3\u03b9\u03bf\u03bc\u03ac\u03c1\u03c4\u03c5\u03c1\u03b1\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03b9 \u0391\u03ba\u03ac\u03ba\u03bf\u03c2 \u1f41 \u1f49\u03c3\u03b9\u03bf\u03bc\u03ac\u03c1\u03c4\u03c5\u03c1\u03b1\u03c2 \u1f00\u03c0\u1f78 \u03c4\u1f78 \u039d\u03b5\u03bf\u03c7\u03ce\u03c1\u03b9 \u0398\u03b5\u03c3\u03c3\u03b1\u03bb\u03bf\u03bd\u03af\u03ba\u03b7\u03c2, \u0395\u1f50\u03b8\u03cd\u03bc\u03b9\u03bf\u03c2 \u1f41 \u03a0\u03b5\u03bb\u03bf\u03c0\u03bf\u03bd\u03bd\u03ae\u03c3\u03b9\u03bf\u03c2 \u03ba\u03b1\u1f76 \u1f39\u03c0\u03c0\u03cc\u03bb\u03c5\u03c4\u03bf\u03c2 \u1f41 \u03bd\u03ad\u03bf\u03c2 \u1f49\u03c3\u03b9\u03bf\u03bc\u03ac\u03c1\u03c4\u03c5\u03c1\u03b1\u03c2"}}, "6969": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u039a\u03bb\u03ae\u03bc\u03b7\u03c2 \u1f31\u03b5\u03c1\u03bf\u03bc\u03ac\u03c1\u03c4\u03c5\u03c1\u03b1\u03c2, \u1f18\u03c0\u03af\u03c3\u03ba\u03bf\u03c0\u03bf\u03c2 \u1fec\u03ce\u03bc\u03b7\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u039a\u03bb\u03ae\u03bc\u03b7\u03c2 \u1f31\u03b5\u03c1\u03bf\u03bc\u03ac\u03c1\u03c4\u03c5\u03c1\u03b1\u03c2, \u1f18\u03c0\u03af\u03c3\u03ba\u03bf\u03c0\u03bf\u03c2 \u1fec\u03ce\u03bc\u03b7\u03c2"}}, "60001": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u039f\u1f50\u03c1\u03c0\u03b1\u03c3\u03b9\u03b1\u03bd\u1f78\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u039f\u1f50\u03c1\u03c0\u03b1\u03c3\u03b9\u03b1\u03bd\u1f78\u03c2"}}, "60102": {"name": {"nominative": "\u1f08\u03bd\u03b1\u03ba\u03bf\u03bc\u03b9\u03b4\u1f74 \u1f31\u03b5\u03c1\u1ff6\u03bd \u039b\u03b5\u03b9\u03c8\u03ac\u03bd\u03c9\u03bd \u03c4\u03bf\u1fe6 \u1f09\u03b3\u03af\u03bf\u03c5 \u0394\u03b7\u03bc\u03b7\u03c4\u03c1\u03af\u03bf\u03c5 \u039c\u03b7\u03c4\u03c1\u03bf\u03c0\u03bf\u03bb\u03af\u03c4\u03b7 \u1fec\u03bf\u03c3\u03c4\u03bf\u03b2\u03af\u03b1\u03c2", "short": "\u1f08\u03bd\u03b1\u03ba\u03bf\u03bc\u03b9\u03b4\u1f74 \u1f31\u03b5\u03c1\u1ff6\u03bd \u039b\u03b5\u03b9\u03c8\u03ac\u03bd\u03c9\u03bd \u03c4\u03bf\u1fe6 \u1f09\u03b3\u03af\u03bf\u03c5 \u0394\u03b7\u03bc\u03b7\u03c4\u03c1\u03af\u03bf\u03c5 \u039c\u03b7\u03c4\u03c1\u03bf\u03c0\u03bf\u03bb\u03af\u03c4\u03b7 \u1fec\u03bf\u03c3\u03c4\u03bf\u03b2\u03af\u03b1\u03c2"}}, "60103": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u0394\u03b7\u03bc\u03ae\u03c4\u03c1\u03b9\u03bf\u03c2 \u039c\u03b7\u03c4\u03c1\u03bf\u03c0\u03bf\u03bb\u03af\u03c4\u03b7\u03c2 \u1fec\u03bf\u03c3\u03c4\u03bf\u03b2\u03af\u03b1\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u0394\u03b7\u03bc\u03ae\u03c4\u03c1\u03b9\u03bf\u03c2 \u039c\u03b7\u03c4\u03c1\u03bf\u03c0\u03bf\u03bb\u03af\u03c4\u03b7\u03c2 \u1fec\u03bf\u03c3\u03c4\u03bf\u03b2\u03af\u03b1\u03c2"}}, "60401": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u0394\u03b7\u03bc\u03ae\u03c4\u03c1\u03b9\u03bf\u03c2 \u1f41 \u039c\u03c5\u03c1\u03bf\u03b2\u03bb\u03cd\u03c4\u03b7\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u0394\u03b7\u03bc\u03ae\u03c4\u03c1\u03b9\u03bf\u03c2 \u1f41 \u039c\u03c5\u03c1\u03bf\u03b2\u03bb\u03cd\u03c4\u03b7\u03c2"}}, "60501": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u0394\u03b7\u03bc\u03ae\u03c4\u03c1\u03b9\u03bf\u03c2 \u1f41 \u03c0\u03c1\u03af\u03b3\u03ba\u03b9\u03c0\u03b1\u03c2 \u1f41 \u0398\u03b1\u03c5\u03bc\u03b1\u03c4\u03bf\u03c5\u03c1\u03b3\u1f78\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u0394\u03b7\u03bc\u03ae\u03c4\u03c1\u03b9\u03bf\u03c2 \u1f41 \u03c0\u03c1\u03af\u03b3\u03ba\u03b9\u03c0\u03b1\u03c2 \u1f41 \u0398\u03b1\u03c5\u03bc\u03b1\u03c4\u03bf\u03c5\u03c1\u03b3\u1f78\u03c2"}}, "60502": {"name": {"nominative": "\u1f08\u03bd\u03b1\u03ba\u03bf\u03bc\u03b9\u03b4\u1f74 \u03a4\u03b9\u03bc\u03af\u03c9\u03bd \u039b\u03b5\u03b9\u03c8\u03ac\u03bd\u03c9\u03bd \u1f09\u03b3\u03af\u03bf\u03c5 \u0394\u03b7\u03bc\u03b7\u03c4\u03c1\u03af\u03bf\u03c5 \u03c4\u03bf\u1fe6 \u0398\u03b1\u03c5\u03bc\u03b1\u03c4\u03bf\u03c5\u03c1\u03b3\u03bf\u1fe6 \u03c4\u03bf\u1fe6 \u03c0\u03c1\u03af\u03b3\u03ba\u03b9\u03c0\u03bf\u03c2", "short": "\u1f08\u03bd\u03b1\u03ba\u03bf\u03bc\u03b9\u03b4\u1f74 \u03a4\u03b9\u03bc\u03af\u03c9\u03bd \u039b\u03b5\u03b9\u03c8\u03ac\u03bd\u03c9\u03bd \u1f09\u03b3\u03af\u03bf\u03c5 \u0394\u03b7\u03bc\u03b7\u03c4\u03c1\u03af\u03bf\u03c5 \u03c4\u03bf\u1fe6 \u0398\u03b1\u03c5\u03bc\u03b1\u03c4\u03bf\u03c5\u03c1\u03b3\u03bf\u1fe6 \u03c4\u03bf\u1fe6 \u03c0\u03c1\u03af\u03b3\u03ba\u03b9\u03c0\u03bf\u03c2"}}, "65301": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u03a3\u03b1\u03b2\u1fd6\u03bd\u03bf\u03c2 \u1f41 \u0391\u1f30\u03b3\u03cd\u03c0\u03c4\u03b9\u03bf\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u03a3\u03b1\u03b2\u1fd6\u03bd\u03bf\u03c2 \u1f41 \u0391\u1f30\u03b3\u03cd\u03c0\u03c4\u03b9\u03bf\u03c2"}}, "67501": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u0394\u03b7\u03bc\u03ae\u03c4\u03c1\u03b9\u03bf\u03c2 \u1f41 \u03a4\u03bf\u03c1\u03bd\u03b1\u03c1\u1fb6\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u0394\u03b7\u03bc\u03ae\u03c4\u03c1\u03b9\u03bf\u03c2 \u1f41 \u03a4\u03bf\u03c1\u03bd\u03b1\u03c1\u1fb6\u03c2"}}, "663201": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u1f38\u1f7c\u03b2 \u039c\u03b7\u03c4\u03c1\u03bf\u03c0\u03bf\u03bb\u03af\u03c4\u03b7\u03c2 \u039c\u03cc\u03c3\u03c7\u03b1\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u1f38\u1f7c\u03b2 \u039c\u03b7\u03c4\u03c1\u03bf\u03c0\u03bf\u03bb\u03af\u03c4\u03b7\u03c2 \u039c\u03cc\u03c3\u03c7\u03b1\u03c2"}}}