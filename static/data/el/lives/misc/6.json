{"60": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u1f08\u03b3\u03ac\u03b8\u03c9\u03bd \u1f41 \u0398\u03b1\u03c5\u03bc\u03b1\u03c4\u03bf\u03c5\u03c1\u03b3\u1f78\u03c2", "short": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u1f08\u03b3\u03ac\u03b8\u03c9\u03bd \u1f41 \u0398\u03b1\u03c5\u03bc\u03b1\u03c4\u03bf\u03c5\u03c1\u03b3\u1f78\u03c2"}}, "600": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0394\u03b7\u03bc\u03ae\u03c4\u03c1\u03b9\u03bf\u03c2 \u1f10\u03ba \u1fec\u03c9\u03c3\u03af\u03b1\u03c2", "short": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0394\u03b7\u03bc\u03ae\u03c4\u03c1\u03b9\u03bf\u03c2 \u1f10\u03ba \u1fec\u03c9\u03c3\u03af\u03b1\u03c2"}}, "601": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u039a\u03b1\u03b9\u03c3\u03ac\u03c1\u03b9\u03bf\u03c2 \u1f00\u03b4\u03b5\u03bb\u03c6\u03cc\u03c2 \u0393\u03c1\u03b7\u03b3\u03bf\u03c1\u03af\u03bf\u03c5 \u0398\u03b5\u03bf\u03bb\u03cc\u03b3\u03bf\u03c5", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u039a\u03b1\u03b9\u03c3\u03ac\u03c1\u03b9\u03bf\u03c2 \u1f00\u03b4\u03b5\u03bb\u03c6\u03cc\u03c2 \u0393\u03c1\u03b7\u03b3\u03bf\u03c1\u03af\u03bf\u03c5 \u0398\u03b5\u03bf\u03bb\u03cc\u03b3\u03bf\u03c5"}}, "602": {"name": {"nominative": "\u03a3\u03cd\u03bd\u03b1\u03be\u03b9\u03c2 \u03c4\u1fc6\u03c2 \u1f59\u03c0\u03b5\u03c1\u03b1\u03b3\u03af\u03b1\u03c2 \u0398\u03b5\u03bf\u03c4\u03cc\u03ba\u03bf\u03c5 \u03c4\u03bf\u03c5 \u0388\u03bd\u03c3\u03b1\u03c1\u03ba\u03bf\u03c5 \u039b\u03cc\u03b3\u03bf\u03c5, \u1f10\u03bd \u1f08\u03bb\u03bc\u03c0\u03b1\u03b6\u1f76\u03bd \u03c4\u1fc6\u03c2 \u1fec\u03c9\u03c3\u03af\u03b1\u03c2", "short": "\u03a3\u03cd\u03bd\u03b1\u03be\u03b9\u03c2 \u03c4\u1fc6\u03c2 \u1f59\u03c0\u03b5\u03c1\u03b1\u03b3\u03af\u03b1\u03c2 \u0398\u03b5\u03bf\u03c4\u03cc\u03ba\u03bf\u03c5 \u03c4\u03bf\u03c5 \u0388\u03bd\u03c3\u03b1\u03c1\u03ba\u03bf\u03c5 \u039b\u03cc\u03b3\u03bf\u03c5, \u1f10\u03bd \u1f08\u03bb\u03bc\u03c0\u03b1\u03b6\u1f76\u03bd \u03c4\u1fc6\u03c2 \u1fec\u03c9\u03c3\u03af\u03b1\u03c2"}}, "604": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03b9 \u039a\u03bf\u03b4\u03c1\u1fb6\u03c4\u03bf\u03c2, \u1f0c\u03bd\u03b5\u03ba\u03c4\u03bf\u03c2, \u03a0\u03b1\u1fe6\u03bb\u03bf\u03c2, \u0394\u03b9\u03bf\u03bd\u03cd\u03c3\u03b9\u03bf\u03c2, \u039a\u03c5\u03c0\u03c1\u03b9\u03b1\u03bd\u1f78\u03c2 \u03ba\u03b1\u1f76 \u039a\u03c1\u03ae\u03c3\u03ba\u03b7\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03b9 \u039a\u03bf\u03b4\u03c1\u1fb6\u03c4\u03bf\u03c2, \u1f0c\u03bd\u03b5\u03ba\u03c4\u03bf\u03c2, \u03a0\u03b1\u1fe6\u03bb\u03bf\u03c2, \u0394\u03b9\u03bf\u03bd\u03cd\u03c3\u03b9\u03bf\u03c2, \u039a\u03c5\u03c0\u03c1\u03b9\u03b1\u03bd\u1f78\u03c2 \u03ba\u03b1\u1f76 \u039a\u03c1\u03ae\u03c3\u03ba\u03b7\u03c2"}}, "607": {"name": {"nominative": "\u1f49\u03c3\u03af\u03b1 \u1f08\u03bd\u03b1\u03c3\u03c4\u03b1\u03c3\u03af\u03b1 \u1f21 \u03a0\u03b1\u03c4\u03c1\u03b9\u03ba\u03af\u03b1", "short": "\u1f49\u03c3\u03af\u03b1 \u1f08\u03bd\u03b1\u03c3\u03c4\u03b1\u03c3\u03af\u03b1 \u1f21 \u03a0\u03b1\u03c4\u03c1\u03b9\u03ba\u03af\u03b1"}}, "614": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u03a3\u03c9\u03c6\u03c1\u03cc\u03bd\u03b9\u03bf\u03c2 \u03a0\u03b1\u03c4\u03c1\u03b9\u03ac\u03c1\u03c7\u03b7\u03c2 \u1f39\u03b5\u03c1\u03bf\u03c3\u03bf\u03bb\u03cd\u03bc\u03c9\u03bd", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u03a3\u03c9\u03c6\u03c1\u03cc\u03bd\u03b9\u03bf\u03c2 \u03a0\u03b1\u03c4\u03c1\u03b9\u03ac\u03c1\u03c7\u03b7\u03c2 \u1f39\u03b5\u03c1\u03bf\u03c3\u03bf\u03bb\u03cd\u03bc\u03c9\u03bd"}}, "619": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03b9 \u03a0\u03b9\u03cc\u03bd\u03b9\u03bf\u03c2 \u1f41 \u03a0\u03c1\u03b5\u03c3\u03b2\u03cd\u03c4\u03b5\u03c1\u03bf\u03c2 \u03ba\u03b1\u1f76 \u03a3\u03b1\u03b2\u03af\u03bd\u03b1", "short": "\u1f0d\u03b3\u03b9\u03bf\u03b9 \u03a0\u03b9\u03cc\u03bd\u03b9\u03bf\u03c2 \u1f41 \u03a0\u03c1\u03b5\u03c3\u03b2\u03cd\u03c4\u03b5\u03c1\u03bf\u03c2 \u03ba\u03b1\u1f76 \u03a3\u03b1\u03b2\u03af\u03bd\u03b1"}}, "621": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0398\u03b5\u03bf\u03c6\u03ac\u03bd\u03b7\u03c2 \u1f41 \u1f49\u03bc\u03bf\u03bb\u03bf\u03b3\u03b7\u03c4\u1f74\u03c2 \u03c4\u1fc6\u03c2 \u03a3\u03c5\u03b3\u03c1\u03b9\u03b1\u03bd\u1f74\u03c2", "short": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0398\u03b5\u03bf\u03c6\u03ac\u03bd\u03b7\u03c2 \u1f41 \u1f49\u03bc\u03bf\u03bb\u03bf\u03b3\u03b7\u03c4\u1f74\u03c2 \u03c4\u1fc6\u03c2 \u03a3\u03c5\u03b3\u03c1\u03b9\u03b1\u03bd\u1f74\u03c2"}}, "623": {"name": {"nominative": "\u0394\u03af\u03ba\u03b1\u03b9\u03bf\u03c2 \u03a6\u03b9\u03bd\u03b5\u1f72\u03c2", "short": "\u0394\u03af\u03ba\u03b1\u03b9\u03bf\u03c2 \u03a6\u03b9\u03bd\u03b5\u1f72\u03c2"}}, "626": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u03a3\u03c5\u03bc\u03b5\u1f7c\u03bd \u1f41 \u0395\u1f50\u03bb\u03b1\u03b2\u1f74\u03c2", "short": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u03a3\u03c5\u03bc\u03b5\u1f7c\u03bd \u1f41 \u0395\u1f50\u03bb\u03b1\u03b2\u1f74\u03c2"}}, "630": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0394\u03b9\u03bf\u03bd\u03cd\u03c3\u03b9\u03bf\u03c2 \u03c4\u03bf\u1fe6 \u1fec\u03b1\u03bd\u03c4\u03bf\u03bd\u1f72\u03b6", "short": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0394\u03b9\u03bf\u03bd\u03cd\u03c3\u03b9\u03bf\u03c2 \u03c4\u03bf\u1fe6 \u1fec\u03b1\u03bd\u03c4\u03bf\u03bd\u1f72\u03b6"}}, "631": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u0394\u03b9\u03bf\u03bd\u03cd\u03c3\u03b9\u03bf\u03c2 \u1f08\u03c1\u03c7\u03b9\u03b5\u03c0\u03af\u03c3\u03ba\u03bf\u03c0\u03bf\u03c2 \u03a3\u03bf\u03c5\u03b6\u03b4\u03b1\u03bb\u03af\u03b1\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u0394\u03b9\u03bf\u03bd\u03cd\u03c3\u03b9\u03bf\u03c2 \u1f08\u03c1\u03c7\u03b9\u03b5\u03c0\u03af\u03c3\u03ba\u03bf\u03c0\u03bf\u03c2 \u03a3\u03bf\u03c5\u03b6\u03b4\u03b1\u03bb\u03af\u03b1\u03c2"}}, "633": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03b9 \u1f08\u03c6\u03c1\u03b9\u03ba\u03b1\u03bd\u1f78\u03c2, \u03a0\u03bf\u03cd\u03c0\u03bb\u03b9\u03bf\u03c2 \u03ba\u03b1\u1f76 \u03a4\u03b5\u03c1\u03ad\u03bd\u03c4\u03b9\u03bf\u03c2 \u03bf\u1f31 \u039c\u03ac\u03c1\u03c4\u03c5\u03c1\u03b5\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03b9 \u1f08\u03c6\u03c1\u03b9\u03ba\u03b1\u03bd\u1f78\u03c2, \u03a0\u03bf\u03cd\u03c0\u03bb\u03b9\u03bf\u03c2 \u03ba\u03b1\u1f76 \u03a4\u03b5\u03c1\u03ad\u03bd\u03c4\u03b9\u03bf\u03c2 \u03bf\u1f31 \u039c\u03ac\u03c1\u03c4\u03c5\u03c1\u03b5\u03c2"}}, "634": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u1f08\u03bb\u03ad\u03be\u03b1\u03bd\u03b4\u03c1\u03bf\u03c2, \u1f41 \u1f10\u03bd \u03a0\u03cd\u03b4\u03bd\u1fc3", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u1f08\u03bb\u03ad\u03be\u03b1\u03bd\u03b4\u03c1\u03bf\u03c2"}}, "635": {"name": {"nominative": "\u1f09\u03b3\u03af\u03b1 \u03a7\u03c1\u03b9\u03c3\u03c4\u03af\u03bd\u03b1 \u1f21 \u1f10\u03bd \u03a0\u03b5\u03c1\u03c3\u03af\u03b1", "short": "\u1f09\u03b3\u03af\u03b1 \u03a7\u03c1\u03b9\u03c3\u03c4\u03af\u03bd\u03b1 \u1f21 \u1f10\u03bd \u03a0\u03b5\u03c1\u03c3\u03af\u03b1"}}, "638": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0392\u03b5\u03bd\u03ad\u03b4\u03b9\u03ba\u03c4\u03bf\u03c2 \u1f41 \u1f10\u03ba \u039d\u03bf\u03c5\u03c1\u03c3\u03af\u03b1\u03c2", "short": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0392\u03b5\u03bd\u03ad\u03b4\u03b9\u03ba\u03c4\u03bf\u03c2 \u1f41 \u1f10\u03ba \u039d\u03bf\u03c5\u03c1\u03c3\u03af\u03b1\u03c2"}}, "640": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u1fec\u03bf\u03c3\u03c4\u03b9\u03c3\u03bb\u03ac\u03b2\u03bf\u03c2 \u1f41 \u03a0\u03c1\u03af\u03b3\u03ba\u03b9\u03c0\u03b1\u03c2 \u039a\u03b9\u03ad\u03b2\u03bf\u03c5 \u03ba\u03b1\u1f76 \u03a3\u03bc\u03bf\u03bb\u1f72\u03bd\u03c3\u03ba", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u1fec\u03bf\u03c3\u03c4\u03b9\u03c3\u03bb\u03ac\u03b2\u03bf\u03c2 \u1f41 \u03a0\u03c1\u03af\u03b3\u03ba\u03b9\u03c0\u03b1\u03c2 \u039a\u03b9\u03ad\u03b2\u03bf\u03c5 \u03ba\u03b1\u1f76 \u03a3\u03bc\u03bf\u03bb\u1f72\u03bd\u03c3\u03ba"}}, "642": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u0395\u03cd\u03c3\u03c7\u03b7\u03bc\u03bf\u03c2 \u1f24 \u0395\u03c5\u03c3\u03c7\u03ae\u03bc\u03c9\u03bd \u1f41 \u1f49\u03bc\u03bf\u03bb\u03bf\u03b3\u03b7\u03c4\u1f74\u03c2 \u1f18\u03c0\u03af\u03c3\u03ba\u03bf\u03c0\u03bf\u03c2 \u039b\u03b1\u03bc\u03c8\u03ac\u03ba\u03bf\u03c5", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u0395\u03cd\u03c3\u03c7\u03b7\u03bc\u03bf\u03c2 \u1f24 \u0395\u03c5\u03c3\u03c7\u03ae\u03bc\u03c9\u03bd \u1f41 \u1f49\u03bc\u03bf\u03bb\u03bf\u03b3\u03b7\u03c4\u1f74\u03c2 \u1f18\u03c0\u03af\u03c3\u03ba\u03bf\u03c0\u03bf\u03c2 \u039b\u03b1\u03bc\u03c8\u03ac\u03ba\u03bf\u03c5"}}, "643": {"name": {"nominative": "\u03a3\u03cd\u03bd\u03b1\u03be\u03b9\u03c2 \u03c4\u1fc6\u03c2 \u1f59\u03c0\u03b5\u03c1\u03b1\u03b3\u03af\u03b1\u03c2 \u0398\u03b5\u03bf\u03c4\u03cc\u03ba\u03bf\u03c5 \u03c4\u03bf\u1fe6 \u0398\u03b5\u03bf\u03b4\u03ce\u03c1\u03bf\u03c5 \u1f10\u03bd \u1fec\u03c9\u03c3\u03af\u1fb3", "short": "\u03a3\u03cd\u03bd\u03b1\u03be\u03b9\u03c2 \u03c4\u1fc6\u03c2 \u1f59\u03c0\u03b5\u03c1\u03b1\u03b3\u03af\u03b1\u03c2 \u0398\u03b5\u03bf\u03c4\u03cc\u03ba\u03bf\u03c5 \u03c4\u03bf\u1fe6 \u0398\u03b5\u03bf\u03b4\u03ce\u03c1\u03bf\u03c5 \u1f10\u03bd \u1fec\u03c9\u03c3\u03af\u1fb3"}}, "646": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u1f08\u03b3\u03ac\u03c0\u03b9\u03bf\u03c2 \u03ba\u03b1\u1f76 \u03c4\u1ff6\u03bd \u03c3\u1f7a\u03bd \u03b1\u1f50\u03c4\u1ff7 \u03bc\u03ac\u03c1\u03c4\u03c5\u03c1\u03b5\u03c2: \u03a0\u03bb\u03ae\u03c3\u03b9\u03bf\u03c2, \u1fec\u03c9\u03bc\u03cd\u03bb\u03bf\u03c2, \u03a4\u03b9\u03bc\u03cc\u03bb\u03b1\u03bf\u03c2, \u1f08\u03bb\u03ad\u03be\u03b1\u03bd\u03b4\u03c1\u03bf\u03c2, \u1f08\u03bb\u03ad\u03be\u03b1\u03bd\u03b4\u03c1\u03bf\u03c2 (\u1f15\u03c4\u03b5\u03c1\u03bf\u03c2), \u0394\u03b9\u03bf\u03bd\u03cd\u03c3\u03b9\u03bf\u03c2 \u03ba\u03b1\u1f76 \u0394\u03b9\u03bf\u03bd\u03cd\u03c3\u03b9\u03bf\u03c2 (\u1f15\u03c4\u03b5\u03c1\u03bf\u03c2)", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u1f08\u03b3\u03ac\u03c0\u03b9\u03bf\u03c2 \u03ba\u03b1\u1f76 \u03c4\u1ff6\u03bd \u03c3\u1f7a\u03bd \u03b1\u1f50\u03c4\u1ff7 \u03bc\u03ac\u03c1\u03c4\u03c5\u03c1\u03b5\u03c2: \u03a0\u03bb\u03ae\u03c3\u03b9\u03bf\u03c2, \u1fec\u03c9\u03bc\u03cd\u03bb\u03bf\u03c2, \u03a4\u03b9\u03bc\u03cc\u03bb\u03b1\u03bf\u03c2, \u1f08\u03bb\u03ad\u03be\u03b1\u03bd\u03b4\u03c1\u03bf\u03c2, \u1f08\u03bb\u03ad\u03be\u03b1\u03bd\u03b4\u03c1\u03bf\u03c2 (\u1f15\u03c4\u03b5\u03c1\u03bf\u03c2), \u0394\u03b9\u03bf\u03bd\u03cd\u03c3\u03b9\u03bf\u03c2 \u03ba\u03b1\u1f76 \u0394\u03b9\u03bf\u03bd\u03cd\u03c3\u03b9\u03bf\u03c2 (\u1f15\u03c4\u03b5\u03c1\u03bf\u03c2)"}}, "648": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u039d\u03af\u03ba\u03b1\u03bd\u03b4\u03c1\u03bf\u03c2 \u1f41 \u1f10\u03bd \u0391\u1f30\u03b3\u03cd\u03c0\u03c4\u1ff3", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u039d\u03af\u03ba\u03b1\u03bd\u03b4\u03c1\u03bf\u03c2 \u1f41 \u1f10\u03bd \u0391\u1f30\u03b3\u03cd\u03c0\u03c4\u1ff3"}}, "653": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u1f0c\u03b2\u03b9\u03b2\u03bf\u03c2 \u1f00\u03c0\u1f78 \u03c4\u1f74\u03bd \u1f18\u03c1\u03bc\u03bf\u03cd\u03c0\u03bf\u03bb\u03b7", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u1f0c\u03b2\u03b9\u03b2\u03bf\u03c2 \u1f00\u03c0\u1f78 \u03c4\u1f74\u03bd \u1f18\u03c1\u03bc\u03bf\u03cd\u03c0\u03bf\u03bb\u03b7"}}, "654": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u03a0\u03ac\u03c0\u03b1\u03c2 \u03a0\u03ac\u03c0\u03b1\u03c2 \u1f41 \u039c\u03ac\u03c1\u03c4\u03c5\u03c1\u03b1\u03c2 \u1f41 \u1f10\u03bd \u039b\u03c5\u03ba\u03b1\u03bf\u03bd\u03af\u1fb3 \u1f00\u03c3\u03ba\u03ae\u03c3\u03b1\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u03a0\u03ac\u03c0\u03b1\u03c2 \u03a0\u03ac\u03c0\u03b1\u03c2 \u1f41 \u039c\u03ac\u03c1\u03c4\u03c5\u03c1\u03b1\u03c2 \u1f41 \u1f10\u03bd \u039b\u03c5\u03ba\u03b1\u03bf\u03bd\u03af\u1fb3 \u1f00\u03c3\u03ba\u03ae\u03c3\u03b1\u03c2"}}, "655": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u1f08\u03bb\u03ad\u03be\u03b1\u03bd\u03b4\u03c1\u03bf\u03c2 \u1f41 \u1f31\u03b5\u03c1\u03bf\u03bc\u03ac\u03c1\u03c4\u03c5\u03c1\u03b1\u03c2 \u03c0\u03ac\u03c0\u03b1\u03c2 \u1fec\u03ce\u03bc\u03b7\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u1f08\u03bb\u03ad\u03be\u03b1\u03bd\u03b4\u03c1\u03bf\u03c2 \u1f41 \u1f31\u03b5\u03c1\u03bf\u03bc\u03ac\u03c1\u03c4\u03c5\u03c1\u03b1\u03c2 \u03c0\u03ac\u03c0\u03b1\u03c2 \u1fec\u03ce\u03bc\u03b7\u03c2"}}, "663": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u039c\u03b1\u03c1\u1fd6\u03bd\u03bf\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u039c\u03b1\u03c1\u1fd6\u03bd\u03bf\u03c2"}}, "665": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u039a\u03cd\u03c1\u03b9\u03bb\u03bb\u03bf\u03c2 \u1f08\u03c1\u03c7\u03b9\u03b5\u03c0\u03af\u03c3\u03ba\u03bf\u03c0\u03bf\u03c2 \u1f39\u03b5\u03c1\u03bf\u03c3\u03bf\u03bb\u03cd\u03bc\u03c9\u03bd", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u039a\u03cd\u03c1\u03b9\u03bb\u03bb\u03bf\u03c2 \u1f08\u03c1\u03c7\u03b9\u03b5\u03c0\u03af\u03c3\u03ba\u03bf\u03c0\u03bf\u03c2 \u1f39\u03b5\u03c1\u03bf\u03c3\u03bf\u03bb\u03cd\u03bc\u03c9\u03bd"}}, "667": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03b9 \u03a4\u03c1\u03cc\u03c6\u03b9\u03bc\u03bf\u03c2 \u03ba\u03b1\u1f76 \u0395\u1f50\u03ba\u03b1\u03c1\u03c0\u03af\u03c9\u03bd \u03ba\u03b1\u1f76 \u03bf\u1f31 \u03c3\u1f7a\u03bd \u03b1\u1f50\u03c4\u03bf\u1fd6\u03c2 \u039c\u03b1\u03c1\u03c4\u03c5\u03c1\u03ae\u03c3\u03b1\u03bd\u03c4\u03b5\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03b9 \u03a4\u03c1\u03cc\u03c6\u03b9\u03bc\u03bf\u03c2 \u03ba\u03b1\u1f76 \u0395\u1f50\u03ba\u03b1\u03c1\u03c0\u03af\u03c9\u03bd \u03ba\u03b1\u1f76 \u03bf\u1f31 \u03c3\u1f7a\u03bd \u03b1\u1f50\u03c4\u03bf\u1fd6\u03c2 \u039c\u03b1\u03c1\u03c4\u03c5\u03c1\u03ae\u03c3\u03b1\u03bd\u03c4\u03b5\u03c2"}}, "668": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u1f08\u03bd\u03b1\u03bd\u03af\u03b1\u03c2 \u1f41 \u0398\u03b1\u03c5\u03bc\u03b1\u03c4\u03bf\u03c5\u03c1\u03b3\u1f78\u03c2", "short": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u1f08\u03bd\u03b1\u03bd\u03af\u03b1\u03c2 \u1f41 \u0398\u03b1\u03c5\u03bc\u03b1\u03c4\u03bf\u03c5\u03c1\u03b3\u1f78\u03c2"}}, "673": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03b9 \u03a7\u03c1\u03cd\u03c3\u03b1\u03bd\u03b8\u03bf\u03c2 \u03ba\u03b1\u1f76 \u0394\u03b1\u03c1\u03b5\u03af\u03b1", "short": "\u1f0d\u03b3\u03b9\u03bf\u03b9 \u03a7\u03c1\u03cd\u03c3\u03b1\u03bd\u03b8\u03bf\u03c2 \u03ba\u03b1\u1f76 \u0394\u03b1\u03c1\u03b5\u03af\u03b1"}}, "675": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u03a0\u03b1\u03b3\u03c7\u03ac\u03c1\u03b9\u03bf\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u03a0\u03b1\u03b3\u03c7\u03ac\u03c1\u03b9\u03bf\u03c2"}}, "678": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03b9 \u1f08\u03b2\u03b2\u03ac\u03b4\u03b5\u03c2 \u1f10\u03bd \u03c4\u1fc7 \u03bc\u03bf\u03bd\u1fc7 \u03c4\u03bf\u1fe6 \u1f09\u03b3\u03af\u03bf\u03c5 \u03a3\u03ac\u03b2\u03b2\u03b1 \u1f00\u03bd\u03b1\u03b9\u03c1\u03b5\u03b8\u03ad\u03bd\u03c4\u03b5\u03c2, \u03c4\u1ff6\u03bd \u03bb\u03b5\u03b3\u03bf\u03bc\u03ad\u03bd\u03c9\u03bd \u039c\u03b1\u03cd\u03c1\u03c9\u03bd", "short": "\u1f0d\u03b3\u03b9\u03bf\u03b9 \u1f08\u03b2\u03b2\u03ac\u03b4\u03b5\u03c2 \u1f10\u03bd \u03c4\u1fc7 \u03bc\u03bf\u03bd\u1fc7 \u03c4\u03bf\u1fe6 \u1f09\u03b3\u03af\u03bf\u03c5 \u03a3\u03ac\u03b2\u03b2\u03b1 \u1f00\u03bd\u03b1\u03b9\u03c1\u03b5\u03b8\u03ad\u03bd\u03c4\u03b5\u03c2, \u03c4\u1ff6\u03bd \u03bb\u03b5\u03b3\u03bf\u03bc\u03ad\u03bd\u03c9\u03bd \u039c\u03b1\u03cd\u03c1\u03c9\u03bd"}}, "681": {"name": {"nominative": "\u1f09\u03b3\u03af\u03b5\u03c2 \u1f08\u03bb\u03b5\u03be\u03b1\u03bd\u03b4\u03c1\u03af\u03b1, \u039a\u03bb\u03b1\u03c5\u03b4\u03af\u03b1, \u0395\u1f50\u03c6\u03c1\u03b1\u03c3\u03af\u03b1, \u039c\u03b1\u03c4\u03c1\u1ff6\u03bd\u03b1, \u1f38\u03bf\u03c5\u03bb\u03b9\u03b1\u03bd\u1f74, \u0395\u1f50\u03c6\u03b7\u03bc\u03af\u03b1 \u03ba\u03b1\u1f76 \u0398\u03b5\u03bf\u03b4\u03ce\u03c1\u03b1 \u03bf\u1f31 \u039c\u03ac\u03c1\u03c4\u03c5\u03c1\u03b5\u03c2 \u1f10\u03bd \u1f08\u03bc\u03b9\u03bd\u03c3\u1ff7", "short": "\u1f09\u03b3\u03af\u03b5\u03c2 \u1f08\u03bb\u03b5\u03be\u03b1\u03bd\u03b4\u03c1\u03af\u03b1, \u039a\u03bb\u03b1\u03c5\u03b4\u03af\u03b1, \u0395\u1f50\u03c6\u03c1\u03b1\u03c3\u03af\u03b1, \u039c\u03b1\u03c4\u03c1\u1ff6\u03bd\u03b1, \u1f38\u03bf\u03c5\u03bb\u03b9\u03b1\u03bd\u1f74, \u0395\u1f50\u03c6\u03b7\u03bc\u03af\u03b1 \u03ba\u03b1\u1f76 \u0398\u03b5\u03bf\u03b4\u03ce\u03c1\u03b1 \u03bf\u1f31 \u039c\u03ac\u03c1\u03c4\u03c5\u03c1\u03b5\u03c2 \u1f10\u03bd \u1f08\u03bc\u03b9\u03bd\u03c3\u1ff7"}}, "682": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u039d\u03b9\u03ba\u03ae\u03c4\u03b1\u03c2 \u1f41 \u1f49\u03bc\u03bf\u03bb\u03bf\u03b3\u03b7\u03c4\u1f74\u03c2 \u1f18\u03c0\u03af\u03c3\u03ba\u03bf\u03c0\u03bf\u03c2 \u1f08\u03c0\u03bf\u03bb\u03bb\u03c9\u03bd\u03b9\u03ac\u03b4\u03bf\u03c2", "short": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u039d\u03b9\u03ba\u03ae\u03c4\u03b1\u03c2 \u1f41 \u1f49\u03bc\u03bf\u03bb\u03bf\u03b3\u03b7\u03c4\u1f74\u03c2 \u1f18\u03c0\u03af\u03c3\u03ba\u03bf\u03c0\u03bf\u03c2 \u1f08\u03c0\u03bf\u03bb\u03bb\u03c9\u03bd\u03b9\u03ac\u03b4\u03bf\u03c2"}}, "685": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u1f38\u03ac\u03ba\u03c9\u03b2\u03bf\u03c2 \u1f41 \u1f49\u03bc\u03bf\u03bb\u03bf\u03b3\u03b7\u03c4\u1f74\u03c2 \u1f41 \u1f18\u03c0\u03af\u03c3\u03ba\u03bf\u03c0\u03bf\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u1f38\u03ac\u03ba\u03c9\u03b2\u03bf\u03c2 \u1f41 \u1f49\u03bc\u03bf\u03bb\u03bf\u03b3\u03b7\u03c4\u1f74\u03c2 \u1f41 \u1f18\u03c0\u03af\u03c3\u03ba\u03bf\u03c0\u03bf\u03c2"}}, "686": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0392\u03ae\u03c1\u03c5\u03bb\u03bb\u03bf\u03c2 \u1f18\u03c0\u03af\u03c3\u03ba\u03bf\u03c0\u03bf\u03c2 \u039a\u03b1\u03c4\u03ac\u03bd\u03b7\u03c2", "short": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0392\u03ae\u03c1\u03c5\u03bb\u03bb\u03bf\u03c2 \u1f18\u03c0\u03af\u03c3\u03ba\u03bf\u03c0\u03bf\u03c2 \u039a\u03b1\u03c4\u03a