{"804": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u1f18\u03c1\u03bc\u03bf\u03b3\u03ad\u03bd\u03b7\u03c2 \u1f41 \u1f31\u03b5\u03c1\u03bf\u03bc\u03ac\u03c1\u03c4\u03c5\u03c1\u03b1\u03c2 \u03a0\u03b1\u03c4\u03c1\u03b9\u03ac\u03c1\u03c7\u03b7\u03c2 \u039c\u03cc\u03c3\u03c7\u03b1\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u1f18\u03c1\u03bc\u03bf\u03b3\u03ad\u03bd\u03b7\u03c2 \u1f41 \u1f31\u03b5\u03c1\u03bf\u03bc\u03ac\u03c1\u03c4\u03c5\u03c1\u03b1\u03c2 \u03a0\u03b1\u03c4\u03c1\u03b9\u03ac\u03c1\u03c7\u03b7\u03c2 \u039c\u03cc\u03c3\u03c7\u03b1\u03c2"}}, "805": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0393\u03b5\u03ce\u03c1\u03b3\u03b9\u03bf\u03c2 \u1f18\u03c0\u03af\u03c3\u03ba\u03bf\u03c0\u03bf\u03c2 \u039c\u03c5\u03c4\u03b9\u03bb\u03ae\u03bd\u03b7\u03c2", "short": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0393\u03b5\u03ce\u03c1\u03b3\u03b9\u03bf\u03c2 \u1f18\u03c0\u03af\u03c3\u03ba\u03bf\u03c0\u03bf\u03c2 \u039c\u03c5\u03c4\u03b9\u03bb\u03ae\u03bd\u03b7\u03c2"}}, "807": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u039a\u03b1\u03bb\u03bb\u03b9\u03cc\u03c0\u03b9\u03bf\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u039a\u03b1\u03bb\u03bb\u03b9\u03cc\u03c0\u03b9\u03bf\u03c2"}}, "808": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u1fec\u03bf\u03c5\u03c6\u03af\u03bd\u03bf\u03c2 \u1f41 \u0394\u03b9\u03ac\u03ba\u03bf\u03bd\u03bf\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u1fec\u03bf\u03c5\u03c6\u03af\u03bd\u03bf\u03c2 \u1f41 \u0394\u03b9\u03ac\u03ba\u03bf\u03bd\u03bf\u03c2"}}, "811": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03b9 \u1f0c\u03b3\u03b1\u03b2\u03bf\u03c2, \u1fec\u03bf\u1fe6\u03c6\u03bf\u03c2, \u03a6\u03bb\u03ad\u03b3\u03c9\u03bd \u03ba\u03b1\u1f76 \u1f08\u03c3\u03cd\u03b3\u03ba\u03c1\u03b9\u03c4\u03bf\u03c2 \u1f00\u03c0\u1f78 \u03c4\u03bf\u1f7a\u03c2 70 \u1f08\u03c0\u03bf\u03c3\u03c4\u03cc\u03bb\u03bf\u03c5\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03b9 \u1f0c\u03b3\u03b1\u03b2\u03bf\u03c2, \u1fec\u03bf\u1fe6\u03c6\u03bf\u03c2, \u03a6\u03bb\u03ad\u03b3\u03c9\u03bd \u03ba\u03b1\u1f76 \u1f08\u03c3\u03cd\u03b3\u03ba\u03c1\u03b9\u03c4\u03bf\u03c2 \u1f00\u03c0\u1f78 \u03c4\u03bf\u1f7a\u03c2 70 \u1f08\u03c0\u03bf\u03c3\u03c4\u03cc\u03bb\u03bf\u03c5\u03c2"}}, "812": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u039a\u03b5\u03bb\u03b5\u03c3\u03c4\u03af\u03bd\u03bf\u03c2 \u03a0\u03ac\u03c0\u03b1\u03c2 \u1fec\u03ce\u03bc\u03b7\u03c2", "short": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u039a\u03b5\u03bb\u03b5\u03c3\u03c4\u03af\u03bd\u03bf\u03c2 \u03a0\u03ac\u03c0\u03b1\u03c2 \u1fec\u03ce\u03bc\u03b7\u03c2"}}, "813": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u1f18\u03c6\u03c1\u03b1\u1f76\u03bc \u1f41 \u1f10\u03ba \u039a\u03b9\u03ad\u03b2\u03bf\u03c5", "short": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u1f18\u03c6\u03c1\u03b1\u1f76\u03bc \u1f41 \u1f10\u03ba \u039a\u03b9\u03ad\u03b2\u03bf\u03c5"}}, "814": {"name": {"nominative": "\u1f08\u03bd\u03b1\u03ba\u03bf\u03bc\u03b9\u03b4\u1f74 \u03c4\u1ff6\u03bd \u1f31\u03b5\u03c1\u1ff6\u03bd \u039b\u03b5\u03b9\u03c8\u03ac\u03bd\u03c9\u03bd \u03c4\u03bf\u1fe6 \u1f49\u03c3\u03af\u03bf\u03c5 \u1f18\u03c6\u03c1\u03b1\u1f76\u03bc \u1f10\u03ba \u1fec\u03c9\u03c3\u03af\u03b1\u03c2", "short": "\u1f08\u03bd\u03b1\u03ba\u03bf\u03bc\u03b9\u03b4\u1f74 \u03c4\u1ff6\u03bd \u1f31\u03b5\u03c1\u1ff6\u03bd \u039b\u03b5\u03b9\u03c8\u03ac\u03bd\u03c9\u03bd \u03c4\u03bf\u1fe6 \u1f49\u03c3\u03af\u03bf\u03c5 \u1f18\u03c6\u03c1\u03b1\u1f76\u03bc \u1f10\u03ba \u1fec\u03c9\u03c3\u03af\u03b1\u03c2"}}, "815": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u1f18\u03c6\u03c1\u03b1\u1f76\u03bc \u1f41 \u1f10\u03ba \u1fec\u03c9\u03c3\u03af\u03b1\u03c2", "short": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u1f18\u03c6\u03c1\u03b1\u1f76\u03bc \u1f41 \u1f10\u03ba \u1fec\u03c9\u03c3\u03af\u03b1\u03c2"}}, "817": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u1f18\u03c6\u03c1\u03b1\u1f76\u03bc \u1f41 \u03a3\u03cd\u03c1\u03bf\u03c2", "short": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u1f18\u03c6\u03c1\u03b1\u1f76\u03bc \u1f41 \u03a3\u03cd\u03c1\u03bf\u03c2"}}, "818": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u0395\u1f50\u03c8\u03cd\u03c7\u03b9\u03bf\u03c2 \u1f41 \u1f10\u03bd \u039a\u03b1\u03b9\u03c3\u03b1\u03c1\u03b5\u03af\u1fb3", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u0395\u1f50\u03c8\u03cd\u03c7\u03b9\u03bf\u03c2 \u1f41 \u1f10\u03bd \u039a\u03b1\u03b9\u03c3\u03b1\u03c1\u03b5\u03af\u1fb3"}}, "819": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u0391\u1f50\u03b4\u03b9\u03b7\u03c3\u03bf\u1fe6\u03c2 \u03ba\u03b1\u1f76 \u03bf\u1f31 \u03c3\u1f7a\u03bd \u03b1\u1f50\u03c4\u1ff7 \u03c4\u03c1\u03b9\u03b1\u03ba\u03cc\u03c3\u03b9\u03bf\u03b9 \u039c\u03ac\u03c1\u03c4\u03c5\u03c1\u03b5\u03c2 \u1f10\u03bd \u03a0\u03b5\u03c1\u03c3\u03af\u03b4\u03b9", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u0391\u1f50\u03b4\u03b9\u03b7\u03c3\u03bf\u1fe6\u03c2 \u03ba\u03b1\u1f76 \u03bf\u1f31 \u03c3\u1f7a\u03bd \u03b1\u1f50\u03c4\u1ff7 \u03c4\u03c1\u03b9\u03b1\u03ba\u03cc\u03c3\u03b9\u03bf\u03b9 \u039c\u03ac\u03c1\u03c4\u03c5\u03c1\u03b5\u03c2 \u1f10\u03bd \u03a0\u03b5\u03c1\u03c3\u03af\u03b4\u03b9"}}, "820": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u0392\u03ac\u03b4\u03b9\u03bc\u03bf\u03c2 \u1f49\u03c3\u03b9\u03bf\u03bc\u03ac\u03c1\u03c4\u03c5\u03c1\u03b1\u03c2 \u03ba\u03b1\u1f76 \u03bf\u1f31 \u1f11\u03c0\u03c4\u1f70 \u039c\u03b1\u03b8\u03b7\u03c4\u03ad\u03c2 \u03c4\u03bf\u1fe6", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u0392\u03ac\u03b4\u03b9\u03bc\u03bf\u03c2 \u1f49\u03c3\u03b9\u03bf\u03bc\u03ac\u03c1\u03c4\u03c5\u03c1\u03b1\u03c2 \u03ba\u03b1\u1f76 \u03bf\u1f31 \u1f11\u03c0\u03c4\u1f70 \u039c\u03b1\u03b8\u03b7\u03c4\u03ad\u03c2 \u03c4\u03bf\u1fe6"}}, "822": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0396\u03b1\u03c7\u03b1\u03c1\u03af\u03b1\u03c2 \u1f41 \u1f10\u03bd \u03c4\u1fc7 \u039b\u03b1\u03cd\u03c1\u1fb3 \u03c4\u03bf\u1fe6 \u039a\u03b9\u03ad\u03b2\u03bf\u03c5 \u1f00\u03c3\u03ba\u03ae\u03c3\u03b1\u03c2", "short": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0396\u03b1\u03c7\u03b1\u03c1\u03af\u03b1\u03c2 \u1f41 \u1f10\u03bd \u03c4\u1fc7 \u039b\u03b1\u03cd\u03c1\u1fb3 \u03c4\u03bf\u1fe6 \u039a\u03b9\u03ad\u03b2\u03bf\u03c5 \u1f00\u03c3\u03ba\u03ae\u03c3\u03b1\u03c2"}}, "823": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03b9 \u1f38\u03ac\u03ba\u03c9\u03b2\u03bf\u03c2 \u1f41 \u03a0\u03c1\u03b5\u03c3\u03b2\u03cd\u03c4\u03b5\u03c1\u03bf\u03c2 \u03ba\u03b1\u1f76 \u1f08\u03b6\u1fb6\u03c2 \u1f41 \u0394\u03b9\u03ac\u03ba\u03bf\u03bd\u03bf\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03b9 \u1f38\u03ac\u03ba\u03c9\u03b2\u03bf\u03c2 \u1f41 \u03a0\u03c1\u03b5\u03c3\u03b2\u03cd\u03c4\u03b5\u03c1\u03bf\u03c2 \u03ba\u03b1\u1f76 \u1f08\u03b6\u1fb6\u03c2 \u1f41 \u0394\u03b9\u03ac\u03ba\u03bf\u03bd\u03bf\u03c2"}}, "826": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u0393\u03c1\u03b7\u03b3\u03cc\u03c1\u03b9\u03bf\u03c2 \u0395\u0374 \u03a0\u03b1\u03c4\u03c1\u03b9\u03ac\u03c1\u03c7\u03b7\u03c2 \u039a\u03c9\u03bd\u03c3\u03c4\u03b1\u03bd\u03c4\u03b9\u03bd\u03bf\u03c5\u03c0\u03cc\u03bb\u03b5\u03c9\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u0393\u03c1\u03b7\u03b3\u03cc\u03c1\u03b9\u03bf\u03c2 \u0395\u0374 \u03a0\u03b1\u03c4\u03c1\u03b9\u03ac\u03c1\u03c7\u03b7\u03c2 \u039a\u03c9\u03bd\u03c3\u03c4\u03b1\u03bd\u03c4\u03b9\u03bd\u03bf\u03c5\u03c0\u03cc\u03bb\u03b5\u03c9\u03c2"}}, "829": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u1f08\u03bd\u03c4\u03af\u03c0\u03b1\u03c2 \u1f18\u03c0\u03af\u03c3\u03ba\u03bf\u03c0\u03bf\u03c2 \u03a0\u03b5\u03c1\u03b3\u03ac\u03bc\u03bf\u03c5", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u1f08\u03bd\u03c4\u03af\u03c0\u03b1\u03c2 \u1f18\u03c0\u03af\u03c3\u03ba\u03bf\u03c0\u03bf\u03c2 \u03a0\u03b5\u03c1\u03b3\u03ac\u03bc\u03bf\u03c5"}}, "831": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u1f38\u03ac\u03ba\u03c9\u03b2\u03bf\u03c2 \u03c4\u03bf\u1fe6 \u0396\u03b5\u03bb\u03ad\u03b6\u03bd\u03ca\u03c5-\u039c\u03c0\u03bf\u03c1\u1f78\u03ba", "short": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u1f38\u03ac\u03ba\u03c9\u03b2\u03bf\u03c2 \u03c4\u03bf\u1fe6 \u0396\u03b5\u03bb\u03ad\u03b6\u03bd\u03ca\u03c5-\u039c\u03c0\u03bf\u03c1\u1f78\u03ba"}}, "834": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u03a6\u03b1\u03c1\u03bc\u03bf\u03cd\u03b8\u03b9\u03bf\u03c2 \u1f41 \u1f08\u03bd\u03b1\u03c7\u03c9\u03c1\u03b7\u03c4\u1f74\u03c2", "short": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u03a6\u03b1\u03c1\u03bc\u03bf\u03cd\u03b8\u03b9\u03bf\u03c2 \u1f41 \u1f08\u03bd\u03b1\u03c7\u03c9\u03c1\u03b7\u03c4\u1f74\u03c2"}}, "837": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0392\u03b1\u03c3\u03af\u03bb\u03b5\u03b9\u03bf\u03c2 \u1f41 \u1f49\u03bc\u03bf\u03bb\u03bf\u03b3\u03b7\u03c4\u1f74\u03c2 \u1f18\u03c0\u03af\u03c3\u03ba\u03bf\u03c0\u03bf\u03c2 \u03a0\u03b1\u03c1\u03af\u03bf\u03c5", "short": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0392\u03b1\u03c3\u03af\u03bb\u03b5\u03b9\u03bf\u03c2 \u1f41 \u1f49\u03bc\u03bf\u03bb\u03bf\u03b3\u03b7\u03c4\u1f74\u03c2 \u1f18\u03c0\u03af\u03c3\u03ba\u03bf\u03c0\u03bf\u03c2 \u03a0\u03b1\u03c1\u03af\u03bf\u03c5"}}, "841": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03b9 \u039c\u03b7\u03bd\u1fb6\u03c2, \u0394\u03b1\u03b2\u1f76\u03b4 \u03ba\u03b1\u1f76 \u1f38\u03c9\u03ac\u03bd\u03bd\u03b7\u03c2 \u03bf\u1f31 \u1f49\u03c3\u03b9\u03bf\u03bc\u03ac\u03c1\u03c4\u03c5\u03c1\u03b5\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03b9 \u039c\u03b7\u03bd\u1fb6\u03c2, \u0394\u03b1\u03b2\u1f76\u03b4 \u03ba\u03b1\u1f76 \u1f38\u03c9\u03ac\u03bd\u03bd\u03b7\u03c2", "genetive": "\u1f0d\u03b3\u03b9\u03bf\u03b9 \u039c\u03b7\u03bd\u1fb6\u03c2, \u0394\u03b1\u03b2\u1f76\u03b4 \u03ba\u03b1\u1f76 \u1f38\u03c9\u03ac\u03bd\u03bd\u03b7\u03c2"}}, "842": {"name": {"nominative": "\u1f49\u03c3\u03af\u03b1 \u1f08\u03bd\u03b8\u03bf\u1fe6\u03c3\u03b1, \u03b8\u03c5\u03b3\u03b1\u03c4\u03ad\u03c1\u03b1 \u03c4\u03bf\u1fe6 \u039a\u03c9\u03bd\u03c3\u03c4\u03b1\u03bd\u03c4\u03af\u03bd\u03bf\u03c5 \u03c4\u03bf\u1fe6 \u039a\u03bf\u03c0\u03c1\u03ce\u03bd\u03c5\u03bc\u03bf\u03c5", "short": "\u1f49\u03c3\u03af\u03b1 \u1f08\u03bd\u03b8\u03bf\u1fe6\u03c3\u03b1, \u03b8\u03c5\u03b3\u03b1\u03c4\u03ad\u03c1\u03b1 \u03c4\u03bf\u1fe6 \u039a\u03c9\u03bd\u03c3\u03c4\u03b1\u03bd\u03c4\u03af\u03bd\u03bf\u03c5 \u03c4\u03bf\u1fe6 \u039a\u03bf\u03c0\u03c1\u03ce\u03bd\u03c5\u03bc\u03bf\u03c5"}}, "845": {"name": {"nominative": "\u03a3\u03cd\u03bd\u03b1\u03be\u03b9\u03c2 \u1f59\u03c0\u03b5\u03c1\u03b1\u03b3\u03af\u03b1\u03c2 \u0398\u03b5\u03bf\u03c4\u03cc\u03ba\u03bf\u03c5 \u1f10\u03bd \u039c\u03bf\u03cd\u03c1\u03c9\u03bc \u1fec\u03c9\u03c3\u03af\u03b1\u03c2", "short": "\u03a3\u03cd\u03bd\u03b1\u03be\u03b9\u03c2 \u1f59\u03c0\u03b5\u03c1\u03b1\u03b3\u03af\u03b1\u03c2 \u0398\u03b5\u03bf\u03c4\u03cc\u03ba\u03bf\u03c5 \u1f10\u03bd \u039c\u03bf\u03cd\u03c1\u03c9\u03bc \u1fec\u03c9\u03c3\u03af\u03b1\u03c2"}}, "848": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0396\u03c9\u03c3\u03b9\u03bc\u1fb6\u03c2 \u1f10\u03ba \u1fec\u03c9\u03c3\u03af\u03b1\u03c2", "short": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0396\u03c9\u03c3\u03b9\u03bc\u1fb6\u03c2 \u1f10\u03ba \u1fec\u03c9\u03c3\u03af\u03b1\u03c2"}}, "851": {"name": {"nominative": "\u1f09\u03b3\u03af\u03b1 \u0398\u03c9\u03bc\u03b1\u1fd3\u03c2", "short": "\u1f09\u03b3\u03af\u03b1 \u0398\u03c9\u03bc\u03b1\u1fd3\u03c2"}}, "853": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u039c\u03b1\u03c1\u03c4\u1fd6\u03bd\u03bf\u03c2 \u03c0\u03ac\u03c0\u03b1\u03c2 \u1fec\u03ce\u03bc\u03b7\u03c2 \u03ba\u03b1\u1f76 \u03c4\u1ff6\u03bd \u03b4\u03cd\u03bf \u1f18\u03c0\u03b9\u03c3\u03ba\u03cc\u03c0\u03c9\u03bd \u1f49\u03bc\u03bf\u03bb\u03bf\u03b3\u03b7\u03c4\u1ff6\u03bd \u03c4\u1ff6\u03bd \u1f10\u03be\u03bf\u03c1\u03b9\u03c3\u03b8\u03ad\u03bd\u03c4\u03c9\u03bd \u03c3\u1f7a\u03bd \u03c4\u1ff7 \u1f09\u03b3\u03af\u1ff3 \u039c\u03b1\u03c1\u03c4\u03af\u03bd\u1ff3", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u039c\u03b1\u03c1\u03c4\u1fd6\u03bd\u03bf\u03c2 \u03c0\u03ac\u03c0\u03b1\u03c2 \u1fec\u03ce\u03bc\u03b7\u03c2 \u03ba\u03b1\u1f76 \u03c4\u1ff6\u03bd \u03b4\u03cd\u03bf \u1f18\u03c0\u03b9\u03c3\u03ba\u03cc\u03c0\u03c9\u03bd \u1f49\u03bc\u03bf\u03bb\u03bf\u03b3\u03b7\u03c4\u1ff6\u03bd \u03c4\u1ff6\u03bd \u1f10\u03be\u03bf\u03c1\u03b9\u03c3\u03b8\u03ad\u03bd\u03c4\u03c9\u03bd \u03c3\u1f7a\u03bd \u03c4\u1ff7 \u1f09\u03b3\u03af\u1ff3 \u039c\u03b1\u03c1\u03c4\u03af\u03bd\u1ff3"}}, "854": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0396\u03c9\u03c3\u03b9\u03bc\u1fb6\u03c2", "short": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0396\u03c9\u03c3\u03b9\u03bc\u1fb6\u03c2"}}, "855": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u1f08\u03c1\u03b4\u03b1\u03bb\u03af\u03c9\u03bd \u1f41 \u039c\u1fd6\u03bc\u03bf\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u1f08\u03c1\u03b4\u03b1\u03bb\u03af\u03c9\u03bd \u1f41 \u039c\u1fd6\u03bc\u03bf\u03c2"}}, "857": {"name": {"nominative": "\u03a3\u03cd\u03bd\u03b1\u03be\u03b9\u03c2 \u03c4\u1fc6\u03c2 \u1f59\u03c0\u03b5\u03c1\u03b1\u03b3\u03af\u03b1\u03c2 \u0398\u03b5\u03bf\u03c4\u03cc\u03ba\u03bf\u03c5 \u1f10\u03bd \u0394\u03b1\u03bb\u03bc\u03b1\u03c4\u03af\u1fb3", "short": "\u03a3\u03cd\u03bd\u03b1\u03be\u03b9\u03c2 \u03c4\u1fc6\u03c2 \u1f59\u03c0\u03b5\u03c1\u03b1\u03b3\u03af\u03b1\u03c2 \u0398\u03b5\u03bf\u03c4\u03cc\u03ba\u03bf\u03c5 \u1f10\u03bd \u0394\u03b1\u03bb\u03bc\u03b1\u03c4\u03af\u1fb3"}}, "861": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u03a3\u03bf\u03cd\u03ba\u03b9\u03bf\u03c2 \u1f41 \u039c\u03ac\u03c1\u03c4\u03c5\u03c1\u03b1\u03c2 \u03ba\u03b1\u1f76 \u03bf\u1f31 \u03c3\u1f7a\u03bd \u03b1\u1f50\u03c4\u1ff7 \u03b4\u03ad\u03ba\u03b1 \u1f10\u03bd\u03bd\u03ad\u03b1 \u039c\u03ac\u03c1\u03c4\u03c5\u03c1\u03b5\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u03a3\u03bf\u03cd\u03ba\u03b9\u03bf\u03c2 \u1f41 \u039c\u03ac\u03c1\u03c4\u03c5\u03c1\u03b1\u03c2 \u03ba\u03b1\u1f76 \u03bf\u1f31 \u03c3\u1f7a\u03bd \u03b1\u1f50\u03c4\u1ff7 \u03b4\u03ad\u03ba\u03b1 \u1f10\u03bd\u03bd\u03ad\u03b1 \u039c\u03ac\u03c1\u03c4\u03c5\u03c1\u03b5\u03c2"}}, "867": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u039b\u03b5\u03c9\u03bd\u03af\u03b4\u03b7\u03c2 \u03ba\u03b1\u1f76 \u03bf\u1f31 \u1f09\u03b3\u03af\u03b5\u03c2 \u03a7\u03ac\u03c1\u03b9\u03c3\u03c3\u03b1, \u039d\u03af\u03ba\u03b7, \u0393\u03b1\u03bb\u03ae\u03bd\u03b7, \u039a\u03b1\u03bb\u03bb\u03af\u03b4\u03b1, \u039d\u03bf\u03c5\u03bd\u03b5\u03c7\u03af\u03b1, \u0392\u03b1\u03c3\u03af\u03bb\u03b9\u03c3\u03c3\u03b1 \u03ba\u03b1\u1f76 \u0398\u03b5\u03bf\u03b4\u03ce\u03c1\u03b1", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u039b\u03b5\u03c9\u03bd\u03af\u03b4\u03b7\u03c2 \u03ba\u03b1\u1f76 \u03bf\u1f31 \u1f09\u03b3\u03af\u03b5\u03c2 \u03a7\u03ac\u03c1\u03b9\u03c3\u03c3\u03b1, \u039d\u03af\u03ba\u03b7, \u0393\u03b1\u03bb\u03ae\u03bd\u03b7, \u039a\u03b1\u03bb\u03bb\u03af\u03b4\u03b1, \u039d\u03bf\u03c5\u03bd\u03b5\u03c7\u03af\u03b1, \u0392\u03b1\u03c3\u03af\u03bb\u03b9\u03c3\u03c3\u03b1 \u03ba\u03b1\u1f76 \u0398\u03b5\u03bf\u03b4\u03ce\u03c1\u03b1"}}, "869": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u1f38\u03ac\u03ba\u03c9\u03b2\u03bf\u03c2 \u1f41 \u1f08\u03c0\u03cc\u03c3\u03c4\u03bf\u03bb\u03bf\u03c2 \u03ba\u03b1\u1f76 \u1f08\u03b4\u03b5\u03bb\u03c6\u03cc\u03b8\u03b5\u03bf\u03c2 \u03c0\u03c1\u1ff6\u03c4\u03bf\u03c2 \u1f18\u03c0\u03af\u03c3\u03ba\u03bf\u03c0\u03bf\u03c2 \u1f39\u03b5\u03c1\u03bf\u03c3\u03bf\u03bb\u03cd\u03bc\u03c9\u03bd", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u1f38\u03ac\u03ba\u03c9\u03b2\u03bf\u03c2 \u1f41 \u1f08\u03c0\u03cc\u03c3\u03c4\u03bf\u03bb\u03bf\u03c2 \u03ba\u03b1\u1f76 \u1f08\u03b4\u03b5\u03bb\u03c6\u03cc\u03b8\u03b5\u03bf\u03c2 \u03c0\u03c1\u1ff6\u03c4\u03bf\u03c2 \u1f18\u03c0\u03af\u03c3\u03ba\u03bf\u03c0\u03bf\u03c2 \u1f39\u03b5\u03c1\u03bf\u03c3\u03bf\u03bb\u03cd\u03bc\u03c9\u03bd"}}, "870": {"name": {"nominative": "\u03a3\u03cd\u03bd\u03b1\u03be\u03b9\u03c2 \u03c4\u1fc6\u03c2 \u1f59\u03c0\u03b5\u03c1\u03b1\u03b3\u03af\u03b1\u03c2 \u0398\u03b5\u03bf\u03c4\u03cc\u03ba\u03bf\u03c5 \u03c4\u03bf\u1fe6 \u03a4\u03b1\u03bc\u03c0\u1f7c\u03c6 \u1f10\u03bd \u1fec\u03c9\u03c3\u03af\u1fb3", "short": "\u03a3\u03cd\u03bd\u03b1\u03be\u03b9\u03c2 \u03c4\u1fc6\u03c2 \u1f59\u03c0\u03b5\u03c1\u03b1\u03b3\u03af\u03b1\u03c2 \u0398\u03b5\u03bf\u03c4\u03cc\u03ba\u03bf\u03c5 \u03c4\u03bf\u1fe6 \u03a4\u03b1\u03bc\u03c0\u1f7c\u03c6 \u1f10\u03bd \u1fec\u03c9\u03c3\u03af\u1fb3"}}, "872": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u1f38\u03ac\u03ba\u03c9\u03b2\u03bf\u03c2 \u1f41 \u1f08\u03c0\u03cc\u03c3\u03c4\u03bf\u03bb\u03bf\u03c2 \u1f00\u03b4\u03b5\u03bb\u03c6\u03cc\u03c2 \u1f38\u03c9\u03ac\u03bd\u03bd\u03bf\u03c5 \u03c4\u03bf\u1fe6 \u0398\u03b5\u03bf\u03bb\u03cc\u03b3\u03bf\u03c5", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u1f38\u03ac\u03ba\u03c9\u03b2\u03bf\u03c2 \u1f41 \u1f08\u03c0\u03cc\u03c3\u03c4\u03bf\u03bb\u03bf\u03c2 \u1f00\u03b4\u03b5\u03bb\u03c6\u03cc\u03c2 \u1f38\u03c9\u03ac\u03bd\u03bd\u03bf\u03c5 \u03c4\u03bf\u1fe6 \u0398\u03b5\u03bf\u03bb\u03cc\u03b3\u03bf\u03c5"}}, "873": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u03a3\u03c5\u03bc\u03b5\u1f7c\u03bd \u1f18\u03c0\u03af\u03c3\u03ba\u03bf\u03c0\u03bf\u03c2 \u03a0\u03b5\u03c1\u03c3\u03af\u03b1\u03c2 \u03ba\u03b1\u1f76 \u03bf\u1f31 \u03bc\u03b1\u03c1\u03c4\u03c5\u03c1\u03ae\u03c3\u03b1\u03bd\u03c4\u03b5\u03c2 \u03bc\u03b1\u03b6\u1f76 \u03bc\u0374 \u03b1\u1f50\u03c4\u03cc\u03bd \u0391\u03cd\u03b4\u03b5\u03bb\u03b1\u03c2 \u1f41 \u03c0\u03c1\u03b5\u03c3\u03b2\u03cd\u03c4\u03b5\u03c1\u03bf\u03c2, \u0393\u03bf\u03b8\u03b1\u03b6\u03ac\u03c4, \u03a6\u03bf\u03c5\u03c3\u03af\u03ba \u03ba\u03b1\u1f76 \u1f04\u03bb\u03bb\u03bf\u03b9 1150", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u03a3\u03c5\u03bc\u03b5\u1f7c\u03bd \u1f18\u03c0\u03af\u03c3\u03ba\u03bf\u03c0\u03bf\u03c2 \u03a0\u03b5\u03c1\u03c3\u03af\u03b1\u03c2 \u03ba\u03b1\u1f76 \u03bf\u1f31 \u03bc\u03b1\u03c1\u03c4\u03c5\u03c1\u03ae\u03c3\u03b1\u03bd\u03c4\u03b5\u03c2 \u03bc\u03b1\u03b6\u1f76 \u03bc\u0374 \u03b1\u1f50\u03c4\u03cc\u03bd \u0391\u03cd\u03b4\u03b5\u03bb\u03b1\u03c2 \u1f41 \u03c0\u03c1\u03b5\u03c3\u03b2\u03cd\u03c4\u03b5\u03c1\u03bf\u03c2, \u0393\u03bf\u03b8\u03b1\u03b6\u03ac\u03c4, \u03a6\u03bf\u03c5\u03c3\u03af\u03ba \u03ba\u03b1\u1f76 \u1f04\u03bb\u03bb\u03bf\u03b9 1150"}}, "878": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u1f08\u03b3\u03b1\u03c0\u03b7\u03c4\u1f78\u03c2 \u03c0\u03ac\u03c0\u03b1\u03c2 \u1fec\u03ce\u03bc\u03b7\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u1f08\u03b3\u03b1\u03c0\u03b7\u03c4\u1f78\u03c2 \u03c0\u03ac\u03c0\u03b1\u03c2 \u1fec\u03ce\u03bc\u03b7\u03c2"}}, "880": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u1f38\u03c9\u03ac\u03bd\u03bd\u03b7\u03c2 \u1f41 \u1f29\u03c3\u03c5\u03c7\u03b1\u03c3\u03c4\u1f74\u03c2, \u03bc\u03b1\u03b8\u03b7\u03c4\u1f74\u03c2 \u03c4\u03bf\u1fe6 \u1f09\u03b3\u03af\u03bf\u03c5 \u0393\u03c1\u03b7\u03b3\u03bf\u03c1\u03af\u03bf\u03c5 \u03c4\u03bf\u1fe6 \u0394\u03b5\u03ba\u03b1\u03c0\u03bf\u03bb\u03af\u03c4\u03bf\u03c5", "short": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u1f38\u03c9\u03ac\u03bd\u03bd\u03b7\u03c2 \u1f41 \u1f29\u03c3\u03c5\u03c7\u03b1\u03c3\u03c4\u1f74\u03c2, \u03bc\u03b1\u03b8\u03b7\u03c4\u1f74\u03c2 \u03c4\u03bf\u1fe6 \u1f09\u03b3\u03af\u03bf\u03c5 \u0393\u03c1\u03b7\u03b3\u03bf\u03c1\u03af\u03bf\u03c5 \u03c4\u03bf\u1fe6 \u0394\u03b5\u03ba\u03b1\u03c0\u03bf\u03bb\u03af\u03c4\u03bf\u03c5"}}, "881": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03b9 \u0392\u03af\u03ba\u03c4\u03c9\u03c1, \u0396\u03c9\u03c4\u03b9\u03ba\u1f78\u03c2, \u1f08\u03ba\u03af\u03bd\u03b4\u03c5\u03bd\u03bf\u03c2, \u039a\u03b1\u03b9\u03c3\u03ac\u03c1\u03b9\u03bf\u03c2, \u03a3\u03b5\u03b2\u03b7\u03c1\u03b9\u03b1\u03bd\u1f78\u03c2, \u03a7\u03c1\u03b9\u03c3\u03c4\u03cc\u03c6\u03bf\u03c1\u03bf\u03c2, \u0396\u03ae\u03bd\u03c9\u03bd, \u0398\u03b5\u03c9\u03bd\u1fb6\u03c2 \u03ba\u03b1\u1f76 \u1f08\u03bd\u03c4\u03c9\u03bd\u1fd6\u03bd\u03bf\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03b9 \u0392\u03af\u03ba\u03c4\u03c9\u03c1, \u0396\u03c9\u03c4\u03b9\u03ba\u1f78\u03c2, \u1f08\u03ba\u03af\u03bd\u03b4\u03c5\u03bd\u03bf\u03c2, \u039a\u03b1\u03b9\u03c3\u03ac\u03c1\u03b9\u03bf\u03c2, \u03a3\u03b5\u03b2\u03b7\u03c1\u03b9\u03b1\u03bd\u1f78\u03c2, \u03a7\u03c1\u03b9\u03c3\u03c4\u03cc\u03c6\u03bf\u03c1\u03bf\u03c2, \u0396\u03ae\u03bd\u03c9\u03bd, \u0398\u03b5\u03c9\u03bd\u1fb6\u03c2 \u03ba\u03b1\u1f76 \u1f08\u03bd\u03c4\u03c9\u03bd\u1fd6\u03bd\u03bf\u03c2"}}, "882": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u039a\u03bf\u03c3\u03bc\u1fb6\u03c2 \u1f41 \u1f49\u03bc\u03bf\u03bb\u03bf\u03b3\u03b7\u03c4\u1f74\u03c2 \u1f18\u03c0\u03af\u03c3\u03ba\u03bf\u03c0\u03bf\u03c2 \u03a7\u03b1\u03bb\u03ba\u03b7\u03b4\u03cc\u03bd\u03bf\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u039a\u03bf\u03c3\u03bc\u1fb6\u03c2 \u1f41 \u1f49\u03bc\u03bf\u03bb\u03bf\u03b3\u03b7\u03c4\u1f74\u03c2 \u1f18\u03c0\u03af\u03c3\u03ba\u03bf\u03c0\u03bf\u03c2 \u03a7\u03b1\u03bb\u03ba\u03b7\u03b4\u03cc\u03bd\u03bf\u03c2"}}, "883": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u1f38\u03c9\u03ac\u03bd\u03bd\u03b7\u03c2 \u1f41 \u1fec\u03ac\u03c0\u03c4\u03b7\u03c2 \u1f41 \u039d\u03b5\u03bf\u03bc\u03ac\u03c1\u03c4\u03c5\u03c1\u03b1\u03c2 \u1f10\u03be \u1f38\u03c9\u03b1\u03bd\u03bd\u03af\u03bd\u03c9\u03bd", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u1f38\u03c9\u03ac\u03bd\u03bd\u03b7\u03c2 \u1f41 \u1fec\u03ac\u03c0\u03c4\u03b7\u03c2 \u1f41 \u039d\u03b5\u03bf\u03bc\u03ac\u03c1\u03c4\u03c5\u03c1\u03b1\u03c2 \u1f10\u03be \u1f38\u03c9\u03b1\u03bd\u03bd\u03af\u03bd\u03c9\u03bd"}}, "885": {"name": {"nominative": "\u03a3\u03cd\u03bd\u03b1\u03be\u03b9\u03c2 \u03c4\u1fc6\u03c2 \u1f59\u03c0\u03b5\u03c1\u03b1\u03b3\u03af\u03b1\u03c2 \u0398\u03b5\u03bf\u03c4\u03cc\u03ba\u03bf\u03c5 \u03c4\u03bf\u1fe6 \u039c\u03b1\u03be\u03af\u03bc\u03bf\u03c5", "short": "\u03a3\u03cd\u03bd\u03b1\u03be\u03b9\u03c2 \u03c4\u1fc6\u03c2 \u1f59\u03c0\u03b5\u03c1\u03b1\u03b3\u03af\u03b1\u03c2 \u0398\u03b5\u03bf\u03c4\u03cc\u03ba\u03bf\u03c5 \u03c4\u03bf\u1fe6 \u039c\u03b1\u03be\u03af\u03bc\u03bf\u03c5"}}, "891": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u03a0\u03b1\u03c6\u03bd\u03bf\u03cd\u03c4\u03b9\u03bf\u03c2 \u1f41 \u1f39\u03b5\u03c1\u03bf\u03bc\u03ac\u03c1\u03c4\u03c5\u03c1\u03b1\u03c2, \u1f31\u03b5\u03c1\u03bf\u03bc\u03ac\u03c1\u03c4\u03c5\u03c1\u03b1\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u03a0\u03b1\u03c6\u03bd\u03bf\u03cd\u03c4\u03b9\u03bf\u03c2 \u1f41 \u1f39\u03b5\u03c1\u03bf\u03bc\u03ac\u03c1\u03c4\u03c5\u03c1\u03b1\u03c2, \u1f31\u03b5\u03c1\u03bf\u03bc\u03ac\u03c1\u03c4\u03c5\u03c1\u03b1\u03c2"}}, "892": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0393\u03b5\u03ce\u03c1\u03b3\u03b9\u03bf\u03c2 \u1f41 \u1f49\u03bc\u03bf\u03bb\u03bf\u03b3\u03b7\u03c4\u1f74\u03c2 \u1f18\u03c0\u03af\u03c3\u03ba\u03bf\u03c0\u03bf\u03c2 \u03a0\u03b9\u03c3\u03b9\u03b4\u03af\u03b1\u03c2", "short": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0393\u03b5\u03ce\u03c1\u03b3\u03b9\u03bf\u03c2", "genetive": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0393\u03b5\u03ce\u03c1\u03b3\u03b9\u03bf\u03c2"}}, "893": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u03a4\u03c1\u03cd\u03c6\u03c9\u03bd \u03a0\u03b1\u03c4\u03c1\u03b9\u03ac\u03c1\u03c7\u03b7\u03c2 \u039a\u03c9\u03bd\u03c3\u03c4\u03b1\u03bd\u03c4\u03b9\u03bd\u03bf\u03c5\u03c0\u03cc\u03bb\u03b5\u03c9\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u03a4\u03c1\u03cd\u03c6\u03c9\u03bd \u03a0\u03b1\u03c4\u03c1\u03b9\u03ac\u03c1\u03c7\u03b7\u03c2 \u039a\u03c9\u03bd\u03c3\u03c4\u03b1\u03bd\u03c4\u03b9\u03bd\u03bf\u03c5\u03c0\u03cc\u03bb\u03b5\u03c9\u03c2"}}, "896": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0398\u03b5\u03cc\u03b4\u03c9\u03c1\u03bf\u03c2 \u1f41 \u03a4\u03c1\u03b9\u03c7\u03b9\u03bd\u1fb6\u03c2", "short": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u0398\u03b5\u03cc\u03b4\u03c9\u03c1\u03bf\u03c2 \u1f41 \u03a4\u03c1\u03b9\u03c7\u03b9\u03bd\u1fb6\u03c2"}}, "897": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u1f38\u03b3\u03bd\u03ac\u03c4\u03b9\u03bf\u03c2 \u1f41 \u0398\u03b5\u03bf\u03c6\u03cc\u03c1\u03bf\u03c2 \u03ba\u03b1\u1f76 \u1f31\u03b5\u03c1\u03bf\u03bc\u03ac\u03c1\u03c4\u03c5\u03c1\u03b1\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u1f38\u03b3\u03bd\u03ac\u03c4\u03b9\u03bf\u03c2 \u1f41 \u0398\u03b5\u03bf\u03c6\u03cc\u03c1\u03bf\u03c2 \u03ba\u03b1\u1f76 \u1f31\u03b5\u03c1\u03bf\u03bc\u03ac\u03c1\u03c4\u03c5\u03c1\u03b1\u03c2"}}, "898": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u1f38\u03b3\u03bd\u03ac\u03c4\u03b9\u03bf\u03c2 \u1f18\u03c0\u03af\u03c3\u03ba\u03bf\u03c0\u03bf\u03c2 \u03a3\u03c4\u03b1\u03c5\u03c1\u03bf\u03c5\u03c0\u03cc\u03bb\u03b5\u03c9\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u1f38\u03b3\u03bd\u03ac\u03c4\u03b9\u03bf\u03c2"}}, "80401": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u1f18\u03c1\u03bc\u03bf\u03b3\u03ad\u03bd\u03b7\u03c2 \u1f41 \u1f31\u03b5\u03c1\u03bf\u03bc\u03ac\u03c1\u03c4\u03c5\u03c1\u03b1\u03c2 \u03a0\u03b1\u03c4\u03c1\u03b9\u03ac\u03c1\u03c7\u03b7\u03c2 \u039c\u03cc\u03c3\u03c7\u03b1\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u1f18\u03c1\u03bc\u03bf\u03b3\u03ad\u03bd\u03b7\u03c2 \u1f41 \u1f31\u03b5\u03c1\u03bf\u03bc\u03ac\u03c1\u03c4\u03c5\u03c1\u03b1\u03c2 \u03a0\u03b1\u03c4\u03c1\u03b9\u03ac\u03c1\u03c7\u03b7\u03c2 \u039c\u03cc\u03c3\u03c7\u03b1\u03c2"}}, "81401": {"name": {"nominative": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u1f18\u03c6\u03c1\u03b1\u1f76\u03bc \u1f41 \u1f10\u03ba \u1fec\u03c9\u03c3\u03af\u03b1\u03c2 \u1f41 \u03b8\u03b1\u03c5\u03bc\u03b1\u03c4\u03bf\u03c5\u03c1\u03b3\u1f78\u03c2", "short": "\u1f4d\u03c3\u03b9\u03bf\u03c2 \u1f18\u03c6\u03c1\u03b1\u1f76\u03bc \u1f41 \u1f10\u03ba \u1fec\u03c9\u03c3\u03af\u03b1\u03c2 \u1f41 \u03b8\u03b1\u03c5\u03bc\u03b1\u03c4\u03bf\u03c5\u03c1\u03b3\u1f78\u03c2"}}, "81501": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u03a0\u03b1\u03c5\u03c3\u03af\u03bb\u03c5\u03c0\u03bf\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u03a0\u03b1\u03c5\u03c3\u03af\u03bb\u03c5\u03c0\u03bf\u03c2"}}, "82201": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03b9 \u1f08\u03c6\u03c1\u03b9\u03ba\u03b1\u03bd\u1f78\u03c2, \u0398\u03b5\u03cc\u03b4\u03c9\u03c1\u03bf\u03c2, \u039c\u03ac\u03be\u03b9\u03bc\u03bf\u03c2, \u03a0\u03bf\u03bc\u03c0\u03b7\u0390\u03bf\u03c2, \u03a4\u03b5\u03c1\u03ad\u03bd\u03c4\u03b9\u03bf\u03c2 \u03ba\u03b1\u1f76 \u03bf\u1f31 \u03c3\u1f7a\u03bd \u03b1\u1f50\u03c4\u03bf\u1fd6\u03c2 \u03c4\u03c1\u03b9\u03ac\u03bd\u03c4\u03b1 \u1f10\u03bd\u03bd\u03ad\u03b1 \u039c\u03ac\u03c1\u03c4\u03c5\u03c1\u03b5\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03b9 \u1f08\u03c6\u03c1\u03b9\u03ba\u03b1\u03bd\u1f78\u03c2, \u0398\u03b5\u03cc\u03b4\u03c9\u03c1\u03bf\u03c2, \u039c\u03ac\u03be\u03b9\u03bc\u03bf\u03c2, \u03a0\u03bf\u03bc\u03c0\u03b7\u0390\u03bf\u03c2, \u03a4\u03b5\u03c1\u03ad\u03bd\u03c4\u03b9\u03bf\u03c2 \u03ba\u03b1\u1f76 \u03bf\u1f31 \u03c3\u1f7a\u03bd \u03b1\u1f50\u03c4\u03bf\u1fd6\u03c2 \u03c4\u03c1\u03b9\u03ac\u03bd\u03c4\u03b1 \u1f10\u03bd\u03bd\u03ad\u03b1 \u039c\u03ac\u03c1\u03c4\u03c5\u03c1\u03b5\u03c2"}}, "85701": {"name": {"nominative": "\u03a3\u03cd\u03bd\u03b1\u03be\u03b9\u03c2 \u03c4\u1fc6\u03c2 \u1f59\u03c0\u03b5\u03c1\u03b1\u03b3\u03af\u03b1\u03c2 \u0398\u03b5\u03bf\u03c4\u03cc\u03ba\u03bf\u03c5 \u1f10\u03bd \u0392\u03b9\u03bb\u1f72\u03bd\u03c3\u03ba \u1fec\u03c9\u03c3\u03af\u03b1\u03c2", "short": "\u03a3\u03cd\u03bd\u03b1\u03be\u03b9\u03c2 \u03c4\u1fc6\u03c2 \u1f59\u03c0\u03b5\u03c1\u03b1\u03b3\u03af\u03b1\u03c2 \u0398\u03b5\u03bf\u03c4\u03cc\u03ba\u03bf\u03c5 \u1f10\u03bd \u0392\u03b9\u03bb\u1f72\u03bd\u03c3\u03ba \u1fec\u03c9\u03c3\u03af\u03b1\u03c2"}}, "86701": {"name": {"nominative": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u1f38\u03ac\u03ba\u03c9\u03b2\u03bf\u03c2 \u03c4\u03bf\u1fe6 \u1f08\u03bb\u03c6\u03b1\u03af\u03bf\u03c5, \u1f41 \u1f08\u03c0\u03cc\u03c3\u03c4\u03bf\u03bb\u03bf\u03c2", "short": "\u1f0d\u03b3\u03b9\u03bf\u03c2 \u1f38\u03ac\u03ba\u03c9\u03b2\u03bf\u03c2 \u03c4\u03bf\u1fe6 \u1f08\u03bb\u03c6\u03b1\u03af\u03bf\u03c5, \u1f41 \u1f08\u03c0\u03cc\u03c3\u03c4\u03bf\u03bb\u03bf\u03c2"}}}