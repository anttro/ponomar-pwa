{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Command Text",
  "description": "Rubric or instruction text",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["type", "value"],
    "properties": {
      "type": {
        "type": "string",
        "enum": ["text"],
        "description": "Node type (lowercase)"
      },
      "value": {
        "type": "string",
        "description": "Text content"
      }
    },
    "additionalProperties": false
  }
}
